        ];
        const GROUPS = [
            { id: 'g1', name: 'HR Team', initials: 'HR', tint: '#B7C9F2', members: '12 members' },
            { id: 'g2', name: 'Design Team', initials: 'DT', tint: '#FFD59E', members: '8 members' },
            { id: 'g3', name: 'Marketing', initials: 'MK', tint: '#A8DAB5', members: '15 members' }
        ];

        const $ = (id) => document.getElementById(id);

        const toWrap = $('cmpTo');
        const chips = $('cmpChips');
        const toInput = $('cmpToInput');
        const sugg = $('cmpSugg');
        const modes = $('cmpModes');
        const browsePop = $('browsePop');
        const browseList = $('browseList');
        const browseAllBox = $('browseAll');
        const tplPop = $('tplPop');
        const sendPop = $('sendPop');
        const laterPop = $('laterPop');

        // ------------------------------------------------------------ helpers
        const initialsOf = (name) => name.split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase();

        const chipNames = () => [...chips.querySelectorAll('.cmp-chip')].map(c => c.dataset.name);

        // the subject line doubles as the group name when creating a group chat
        const syncSubjectLabel = () => {
            const subject = $('cmpSubject');
            if (!subject) return;
            const active = modes.querySelector('.cmp-mode.is-active');
            const isGroup = modes.classList.contains('is-open')
                && active && active.dataset.mode === 'group';
            subject.placeholder = isGroup ? 'Enter Group name' : 'Enter subject';
            subject.setAttribute('aria-label', isGroup ? 'Group name' : 'Subject');

            // the icon has to follow the field's meaning: a group name, not a subject
            const icon = $('cmpSubjectIcon');
            if (icon) icon.className = 'bi cmp-field__icon ' + (isGroup ? 'bi-people' : 'bi-text-left');
        };

        // 02 — two or more recipients reveals the Send Separately / Create Group tabs
        const syncModes = () => {
            modes.classList.toggle('is-open', chipNames().length >= 2);
            syncSubjectLabel();
        };

        modes.addEventListener('click', (e) => {
            const btn = e.target.closest('.cmp-mode');
            if (!btn) return;
            modes.querySelectorAll('.cmp-mode').forEach(b => b.classList.remove('is-active'));
            btn.classList.add('is-active');
            syncSubjectLabel();
        });

        const addRecipient = (entry) => {
            if (chipNames().includes(entry.name)) return;
            const chip = document.createElement('span');
            chip.className = 'cmp-chip';
            chip.dataset.name = entry.name;
            chip.innerHTML =
                '<span class="cmp-chip__av"></span>' +
                '<span class="cmp-chip__name"></span>' +
                '<button type="button" class="cmp-chip__x" aria-label="Remove">&times;</button>';
            chip.querySelector('.cmp-chip__av').textContent = entry.initials || initialsOf(entry.name);
            chip.querySelector('.cmp-chip__name').textContent = entry.name;
            chips.insertBefore(chip, toInput);
            syncModes();
        };

        chips.addEventListener('click', (e) => {
            const x = e.target.closest('.cmp-chip__x');
            if (!x) return;
            x.closest('.cmp-chip').remove();
            syncModes();
        });

        // focus ring on the To field, subject and body
        [[toWrap, toInput], [$('cmpSubjectWrap'), $('cmpSubject')], [$('cmpBodyWrap'), $('cmpMessage')]]
            .forEach(([wrap, input]) => {
                input.addEventListener('focus', () => wrap.classList.add('is-focus'));
                input.addEventListener('blur', () => wrap.classList.remove('is-focus'));
            });

        // -------------------------------------------- 02 live suggestions
        const renderSugg = (term) => {
            const q = term.trim().toLowerCase();
            if (!q) return sugg.classList.remove('is-open');

            const taken = chipNames();
            const people = USERS.filter(u => u.name.toLowerCase().includes(q) && !taken.includes(u.name));
            const groups = GROUPS.filter(g => g.name.toLowerCase().includes(q) && !taken.includes(g.name));

            if (!people.length && !groups.length) {
                sugg.innerHTML = '<p class="cmp-sugg__empty">No matches found.</p>';
                sugg.classList.add('is-open');
                return;
            }

            const rowHtml = (item) =>
                '<div class="cmp-sugg__row" data-name="' + item.name + '" data-initials="' + item.initials + '">' +
                '<span class="cmp-sugg__av" style="background:' + item.tint + '">' + item.initials + '</span>' +
                '<span class="cmp-sugg__name">' + item.name + '</span>' +
                '<button type="button" class="cmp-sugg__add">+ Add</button></div>';

            let html = '';
            if (people.length) html += '<span class="cmp-sugg__label">People</span>' + people.map(rowHtml).join('');
            if (groups.length) html += '<span class="cmp-sugg__label">Groups</span>' + groups.map(rowHtml).join('');
            sugg.innerHTML = html;
            sugg.classList.add('is-open');
        };

        toInput.addEventListener('input', () => renderSugg(toInput.value));

        toInput.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !toInput.value) {
                const last = chips.querySelectorAll('.cmp-chip');
                if (last.length) { last[last.length - 1].remove(); syncModes(); }
            }
            if (e.key === 'Escape') sugg.classList.remove('is-open');
        });

        sugg.addEventListener('click', (e) => {
            const row = e.target.closest('.cmp-sugg__row');
            if (!row) return;
            addRecipient({ name: row.dataset.name, initials: row.dataset.initials });
            toInput.value = '';
            sugg.classList.remove('is-open');
            toInput.focus();
        });

        // ------------------------------------------- 03 / 04 browse popover
        let browseTab = 'users';
        const picked = { users: new Set(), groups: new Set() };

        const sourceFor = (tab) => (tab === 'users' ? USERS : GROUPS);

        const renderBrowse = () => {
            const q = ($('browseSearch').value || '').trim().toLowerCase();
            const rows = sourceFor(browseTab).filter(i => i.name.toLowerCase().includes(q));

            browseList.innerHTML = rows.map(item =>
                '<label class="cmp-browse__row">' +
                '<input type="checkbox" data-pick="' + item.id + '"' +
                (picked[browseTab].has(item.id) ? ' checked' : '') + '>' +
                '<span class="cmp-browse__av" style="background:' + item.tint + '">' + item.initials + '</span>' +
                '<span class="cmp-browse__name">' + item.name +
                (item.members ? '<small>' + item.members + '</small>' : '') +
                '</span></label>'
            ).join('');

            $('usersBadge').textContent = picked.users.size;
            $('groupsBadge').textContent = picked.groups.size;

            const total = picked.users.size + picked.groups.size;
            $('browseCount').textContent = total + ' selected';
            $('browseAdd').disabled = total === 0;

            $('browseAllLabel').textContent = 'Select all ' + browseTab;
            browseAllBox.checked = rows.length > 0 && rows.every(i => picked[browseTab].has(i.id));
        };

        document.querySelectorAll('[data-browse-tab]').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('[data-browse-tab]').forEach(t => t.classList.remove('is-active'));
                tab.classList.add('is-active');
                browseTab = tab.dataset.browseTab;
                renderBrowse();
            });
        });

        browseList.addEventListener('change', (e) => {
            const box = e.target.closest('[data-pick]');
            if (!box) return;
            const id = box.dataset.pick;
            box.checked ? picked[browseTab].add(id) : picked[browseTab].delete(id);
            renderBrowse();
        });

        browseAllBox.addEventListener('change', () => {
            const q = ($('browseSearch').value || '').trim().toLowerCase();
            sourceFor(browseTab).filter(i => i.name.toLowerCase().includes(q)).forEach(i => {
                browseAllBox.checked ? picked[browseTab].add(i.id) : picked[browseTab].delete(i.id);
            });
            renderBrowse();
        });

        $('browseSearch').addEventListener('input', renderBrowse);

        $('browseAdd').addEventListener('click', () => {
            USERS.filter(u => picked.users.has(u.id)).forEach(addRecipient);
            GROUPS.filter(g => picked.groups.has(g.id)).forEach(addRecipient);
            picked.users.clear();
            picked.groups.clear();
            closeAllPops();
            renderBrowse();
        });

        // ------------------------------------------------- popover placement
        const openPop = (pop, anchor, align) => {
            const wasOpen = pop.classList.contains('is-open');
            closeAllPops();
            if (wasOpen) return;

            pop.classList.add('is-open');
            const a = anchor.getBoundingClientRect();
            const w = pop.offsetWidth;
            const h = pop.offsetHeight;

            let left = align === 'right' ? a.right - w : a.left;
            left = Math.max(8, Math.min(left, window.innerWidth - w - 8));

            let top = a.bottom + 8;
            if (top + h > window.innerHeight - 8) top = Math.max(8, a.top - h - 8);

            pop.style.left = (left + window.scrollX) + 'px';
            pop.style.top = (top + window.scrollY) + 'px';
        };

        function closeAllPops() {
            [browsePop, tplPop, sendPop, laterPop].forEach(p => p.classList.remove('is-open'));
            $('cmpTpl').classList.remove('is-active');
            $('cmpLater').classList.remove('is-active');
        }

        $('cmpBrowse').addEventListener('click', (e) => {
            e.stopPropagation();
            sugg.classList.remove('is-open');
            renderBrowse();
            openPop(browsePop, $('cmpBrowse'), 'right');
        });

        // ----------------------------------------------- 08 use template
        $('cmpTpl').addEventListener('click', (e) => {
            e.stopPropagation();
            openPop(tplPop, $('cmpTpl'), 'left');
            $('cmpTpl').classList.toggle('is-active', tplPop.classList.contains('is-open'));
        });

        tplPop.addEventListener('click', (e) => {
            const row = e.target.closest('.cmp-tpl__row');
            if (!row) return;
            $('cmpMessage').value = row.dataset.text;
            closeAllPops();
            $('cmpMessage').focus();
        });

        // --------------------------------------------- 09 send as dropdown
        $('cmpSendCaret').addEventListener('click', (e) => {
            e.stopPropagation();
            openPop(sendPop, $('cmpSendCaret'), 'right');
        });

        const syncSendLabel = () => {
            const msg = $('sendAsMessage').checked;
            const mail = $('sendAsEmail').checked;
            $('cmpSendLabel').textContent =
                msg && mail ? 'Send as Both' : mail ? 'Send as Email' : 'Send as Message';
            sendPop.querySelectorAll('.cmp-sendpop__row').forEach(row => {
                row.classList.toggle('is-on', row.querySelector('input').checked);
            });
        };

        sendPop.addEventListener('change', syncSendLabel);
        sendPop.addEventListener('click', (e) => e.stopPropagation());

        // ---------------------------------------------- 10 send later popup
        $('cmpLater').addEventListener('click', (e) => {
            e.stopPropagation();
            if (!$('laterDate').value) {
                const d = new Date();
                $('laterDate').value = d.toISOString().slice(0, 10);
                $('laterTime').value = '09:00';
            }
            openPop(laterPop, $('cmpLater'), 'left');
            $('cmpLater').classList.toggle('is-active', laterPop.classList.contains('is-open'));
        });

        laterPop.addEventListener('click', (e) => e.stopPropagation());

        $('laterConfirm').addEventListener('click', () => {
            closeAllPops();
            $('cmpLater').classList.add('is-active');
        });

        // ------------------------------------------------- 06 attach files
        const fileInput = $('cmpFileInput');
        const filesWrap = $('cmpFiles');
        const fileRow = $('cmpFileRow');
        let attached = [];

        const prettySize = (bytes) => bytes >= 1048576
            ? (bytes / 1048576).toFixed(1) + ' MB'
            : Math.max(0.1, bytes / 1024).toFixed(1) + ' KB';

        const renderFiles = () => {
            filesWrap.classList.toggle('is-open', attached.length > 0);
            fileRow.innerHTML = attached.map((f, i) =>
                '<div class="cmp-file">' +
                '<span class="cmp-file__icon"><i class="bi bi-file-earmark-text"></i></span>' +
                '<span class="cmp-file__meta">' +
                '<span class="cmp-file__name" title="' + f.name + '">' + f.name + '</span>' +
                '<span class="cmp-file__size">' + f.size + '</span></span>' +
                '<button type="button" class="cmp-file__x" data-drop="' + i + '" aria-label="Remove">' +
                '<i class="bi bi-x-lg"></i></button></div>'
            ).join('');
            $('cmpFileMeta').textContent =
                attached.length + (attached.length === 1 ? ' file' : ' files') +
                ' attached · Attachments will expire in 14 days';
        };

        $('cmpAttach').addEventListener('click', () => fileInput.click());

        fileInput.addEventListener('change', () => {
            [...fileInput.files].forEach(f => attached.push({ name: f.name, size: prettySize(f.size) }));
            fileInput.value = '';
            renderFiles();
        });

        fileRow.addEventListener('click', (e) => {
            const drop = e.target.closest('[data-drop]');
            if (!drop) return;
            attached.splice(Number(drop.dataset.drop), 1);
            renderFiles();
        });

        // ------------------------------------------------ 07 voice to text
        const recBar = $('cmpRec');
        const voiceBtn = $('cmpVoice');

        voiceBtn.addEventListener('click', () => {
            const on = recBar.classList.toggle('is-open');
            voiceBtn.classList.toggle('is-rec', on);
        });

        // -------------------------------------------------------- dismissal
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.cmp-pop') && !e.target.closest('#cmpBrowse') &&
                !e.target.closest('#cmpTpl') && !e.target.closest('#cmpSendCaret') &&
                !e.target.closest('#cmpLater')) {
                closeAllPops();
            }
            if (!e.target.closest('#cmpTo')) sugg.classList.remove('is-open');
        });

        document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape') return;
            closeAllPops();
            sugg.classList.remove('is-open');
        });

        // Cancel / close return to the message list
        [$('cmpCancel'), $('cmpClose')].forEach(btn => {
            btn.addEventListener('click', () => { window.location.href = '/messages'; });
        });

        syncModes();
        renderBrowse();
        syncSendLabel();
    })();
</script>
