<div class="container px-4 my-2 pt-md-4 pt-2 pb-4 pb-md-2" id="desktop">
    <div class="mb-lg-3 mt-lg-2 my-2 pb-lg-2 pb-0">
        <div class="row col-lg-2 col-12 text-brand">
            <a href="/messages/sms"
                class="col-4 col-lg-6 px-4 border-end border-secondary text-muted text-center text-decoration-none">
                SMS
            </a>
            <a href="/messages" class="col-4 col-lg-6 px-4 text-center text-decoration-none text-brand">
                Messaging
            </a>
        </div>
    </div>
    <div class="cmp-stage">
        <!-- =================================================== compose card -->
        <div class="cmp-card" id="composeCard">
            <!-- header -->
            <div class="cmp-head">
                <div class="cmp-head__group">
                    <span class="cmp-head__title">New message</span>
                    <span class="cmp-head__sub">Send to individual users, groups, or both</span>
                </div>
                <button type="button" class="cmp-head__close" id="cmpClose" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- To -->
            <div class="cmp-to" id="cmpTo">
                <div class="cmp-to__chips" id="cmpChips">
                    <span class="cmp-chip" data-name="Clint Barton">
                        <span class="cmp-chip__av">CB</span>
                        <span class="cmp-chip__name">Clint Barton</span>
                        <button type="button" class="cmp-chip__x" aria-label="Remove Clint Barton">&times;</button>
                    </span>
                    <input type="text" class="cmp-to__input" id="cmpToInput" placeholder="Add people or groups…"
                        autocomplete="off" aria-label="Add people or groups">
                </div>
                <button type="button" class="cmp-to__browse" id="cmpBrowse" aria-label="Browse users and groups">
                    <i class="bi bi-plus-lg"></i>
                </button>

                <!-- 02 — live suggestions while typing -->
                <div class="cmp-sugg" id="cmpSugg" role="listbox"></div>
            </div>

            <p class="cmp-hint">Type a name to see live suggestions, or tap + to browse Users / Groups with
                multi-select.</p>

            <!-- 02 — two or more recipients reveals these tabs -->
            <div class="cmp-modes" id="cmpModes">
                <button type="button" class="cmp-mode is-active" data-mode="separate">Send Separately</button>
                <button type="button" class="cmp-mode" data-mode="group">Create Group Chat</button>
            </div>

            <!-- subject -->
            <div class="cmp-field" id="cmpSubjectWrap">
                <i class="bi bi-text-left cmp-field__icon" id="cmpSubjectIcon"></i>
                <input type="text" class="cmp-field__input" id="cmpSubject" placeholder="Enter subject"
                    aria-label="Subject">
            </div>

            <!-- message -->
            <div class="cmp-body" id="cmpBodyWrap">
                <div class="cmp-body__area">
                    <textarea class="cmp-body__input" id="cmpMessage" placeholder="Write a message (optional)"
                        aria-label="Message"></textarea>

                    <!-- 06 — attachments -->
                    <div class="cmp-files" id="cmpFiles">
                        <div class="cmp-files__row" id="cmpFileRow"></div>
                        <div class="cmp-files__bar"><span id="cmpFileBar"></span></div>
                        <div class="cmp-files__meta">
                            <i class="bi bi-paperclip"></i>
                            <span id="cmpFileMeta">0 files attached · Attachments will expire in 14 days</span>
                        </div>
                    </div>

                    <!-- 07 — voice to text -->
                    <div class="cmp-rec" id="cmpRec">
                        <span class="cmp-rec__dot"></span>
                        <span class="cmp-rec__label">Listening… speak your message</span>
                        <span class="cmp-rec__eq">
                            <i></i><i></i><i></i><i></i><i></i>
                        </span>
                    </div>
                </div>

                <!-- toolbar -->
                <div class="cmp-tools">
                    <button type="button" class="cmp-tool" id="cmpAttach">
                        <i class="bi bi-paperclip"></i><span>Attach</span>
                    </button>
                    <button type="button" class="cmp-tool" id="cmpVoice">
                        <i class="bi bi-mic"></i><span>Voice</span>
                    </button>
                    <span class="cmp-tool__divider"></span>
                    <button type="button" class="cmp-tool" id="cmpTpl">
                        <i class="bi bi-file-earmark-text"></i><span>Use template</span>
                    </button>
                    <input type="file" id="cmpFileInput" multiple hidden
                        accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.png,.jpg,.jpeg">
                </div>
            </div>

            <!-- footer -->
            <div class="cmp-foot">
                <button type="button" class="cmp-btn cmp-btn--ghost" id="cmpCancel">Cancel</button>
                <div class="cmp-foot__right">
                    <button type="button" class="cmp-btn cmp-btn--later" id="cmpLater">
                        <i class="bi bi-clock"></i><span>Send later</span>
                    </button>
                    <div class="cmp-send">
                        <button type="button" class="cmp-send__main" id="cmpSend">
                            <i class="bi bi-send"></i><span id="cmpSendLabel">Send as Message</span>
                        </button>
                        <button type="button" class="cmp-send__caret" id="cmpSendCaret" aria-label="Send options">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================ 03 / 04 browse popover -->
    <div class="cmp-pop cmp-browse" id="browsePop">
        <div class="cmp-browse__tabs">
            <button type="button" class="cmp-browse__tab is-active" data-browse-tab="users">
                <i class="bi bi-person"></i>
                <span>Users</span>
                <em class="cmp-browse__badge" id="usersBadge">0</em>
            </button>
            <button type="button" class="cmp-browse__tab" data-browse-tab="groups">
                <i class="bi bi-people"></i>
                <span>Groups</span>
                <em class="cmp-browse__badge" id="groupsBadge">0</em>
            </button>
        </div>
        <label class="cmp-browse__search">
            <i class="bi bi-search"></i>
            <input type="search" id="browseSearch" placeholder="Search to add" aria-label="Search to add">
        </label>
        <label class="cmp-browse__all">
            <input type="checkbox" id="browseAll">
            <span id="browseAllLabel">Select all users</span>
        </label>
        <div class="cmp-browse__list" id="browseList"></div>
        <div class="cmp-browse__foot">
            <span id="browseCount">0 selected</span>
            <button type="button" class="cmp-browse__add" id="browseAdd">Add selected</button>
        </div>
    </div>

    <!-- ================================================= 08 template popover -->
    <div class="cmp-pop cmp-tpl" id="tplPop">
        <span class="cmp-tpl__title">Your Templates</span>
        <div class="cmp-tpl__row" data-text="Quick reminder about our meeting tomorrow at 10 AM. Please come prepared.">
            <span class="cmp-tpl__label">Meeting reminder
                <em>"Quick reminder about our meeting…"</em></span>
            <button type="button" class="cmp-tpl__use">Use</button>
        </div>
        <div class="cmp-tpl__row" data-text="Quick reminder about our meeting this afternoon. See you there.">
            <span class="cmp-tpl__label">Meeting reminder
                <em>"Quick reminder about our meeting…"</em></span>
            <button type="button" class="cmp-tpl__use">Use</button>
        </div>
        <div class="cmp-tpl__row" data-text="Here's the latest status on the project. All milestones are on track.">
            <span class="cmp-tpl__label">Project update
                <em>"Here's the latest status on…"</em></span>
            <button type="button" class="cmp-tpl__use">Use</button>
        </div>
        <div class="cmp-tpl__row" data-text="Here's the latest status on this week's deliverables.">
            <span class="cmp-tpl__label">Project update
                <em>"Here's the latest status on…"</em></span>
            <button type="button" class="cmp-tpl__use">Use</button>
        </div>
        <div class="cmp-tpl__row" data-text="Following up on the deadline for the items we discussed. Any update?">
            <span class="cmp-tpl__label">Deadline follow-up
                <em>"Following up on the deadline for…"</em></span>
            <button type="button" class="cmp-tpl__use">Use</button>
        </div>
    </div>

    <!-- ============================================== 09 send-as dropdown -->
    <div class="cmp-pop cmp-sendpop" id="sendPop">
        <label class="cmp-sendpop__row is-on">
            <i class="bi bi-chat-dots"></i>
            <span>Send as Message</span>
            <input type="checkbox" id="sendAsMessage" checked>
        </label>
        <label class="cmp-sendpop__row">
            <i class="bi bi-envelope"></i>
            <span>Send as Email</span>
            <input type="checkbox" id="sendAsEmail">
        </label>
    </div>

    <!-- ============================================== 10 send later popup -->
    <div class="cmp-pop cmp-later" id="laterPop">
        <span class="cmp-later__title">Schedule this message</span>
        <label class="cmp-later__row">
            <span>Date</span>
            <input type="date" id="laterDate">
        </label>
        <label class="cmp-later__row">
            <span>Time</span>
            <input type="time" id="laterTime">
        </label>
        <button type="button" class="cmp-later__confirm" id="laterConfirm">Confirm schedule</button>
    </div>
</div>

<style>
    /* =============================================== Compose — Figma spec */
    #desktop {
        background: #EEF0F4;
    }

    .cmp-stage {
        display: flex;
        justify-content: center;
        padding: 20px 0 60px;
    }

    .cmp-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 17px;
        width: 860px;
        max-width: 100%;
        padding: 20px 30px;
        background: #FFFFFF;
        box-shadow: 0px 1px 1.5px rgba(22, 27, 34, 0.05), 0px 24px 48px rgba(22, 27, 34, 0.14);
        border-radius: 20px;
    }

    /* ---------------------------------------------------------- header */
    .cmp-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        width: 800px;
        max-width: 100%;
        padding: 15px 16px;
    }

    .cmp-head__group {
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    .cmp-head__title {
        font-size: 22px;
        line-height: 28px;
        color: #161B22;
    }

    .cmp-head__sub {
        font-size: 13px;
        line-height: 16px;
        color: #8A93A6;
    }

    .cmp-head__close {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        padding: 0;
        border: 0;
        border-radius: 17px;
        background: #F5F6FA;
        color: #4A5468;
        font-size: 13px;
        line-height: 1;
    }

    /* bootstrap-icons carry their own line-height, which pushes the glyph off-centre */
    .cmp-head__close i,
    .cmp-to__browse i {
        display: block;
        line-height: 1;
    }

    /* -------------------------------------------------------------- To */
    .cmp-to {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        width: 796px;
        max-width: 100%;
        min-height: 54px;
        padding: 11px 16px;
        border: 1px solid #D3DAE6;
        border-radius: 12px;
    }

    .cmp-to.is-focus {
        border-color: #1D4ED8;
        box-shadow: 0px 0px 0px 3px rgba(29, 78, 216, 0.1);
    }

    .cmp-to__chips {
        display: flex;
        flex: 1;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .cmp-chip {
