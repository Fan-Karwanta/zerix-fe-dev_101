@page
@model MessageIndexModel
@{
Layout = "_Messages";
ViewData["Title"] = "Messages";
ViewData["User"] = "Admin";
}

<style>
    /* ==========================================================================
       Messaging (Group Chat) — Figma
       ========================================================================== */
    .msg-page {
        background: #F5F6FD;
        font-family: 'Plus Jakarta Sans', sans-serif;
        padding-bottom: 40px;
        min-height: calc(100vh - 188px);
    }

    .msg-layout {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        gap: 32px;
        padding-top: 24px;
        height: 787px;
    }

    /* ---------------------------------------------------------------- sidebar */
    .msg-sidebar {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
        width: 346px;
        flex: none;
    }

    .company-select {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 14px 18px;
        width: 100%;
        height: 49px;
        background: #FFFFFF;
        border: 1px solid #D3DAE6;
        border-radius: 10px;
        cursor: pointer;
        position: relative;
    }

    .company-select__label {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 9px;
        font-size: 15px;
        line-height: 19px;
        color: #161B22;
    }

    .company-select__label i {
        font-size: 17px;
        color: #4A5468;
    }

    .company-select__caret {
        font-size: 12px;
        color: #161B22;
    }

    .msg-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 0 0 20px;
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
        background: #FFFFFF;
        box-shadow: 0px 1px 3px rgba(22, 27, 34, 0.05), 0px 8px 20px rgba(22, 27, 34, 0.06);
        border-radius: 16px;
    }

    .msg-card__search {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        padding: 16px 16px 0;
        gap: 10px;
        width: 100%;
    }

    .msg-search-input {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 1px 14px;
        gap: 10px;
        height: 37px;
        flex: 1 1 auto;
        border: 1px solid #CED4DA;
        border-radius: 4px;
    }

    .msg-search-input i {
        font-size: 15px;
        color: #878A99;
    }

    .msg-search-input input {
        border: 0;
        outline: 0;
        width: 100%;
        font-size: 14px;
        line-height: 16px;
        color: #212529;
        background: transparent;
    }

    .msg-search-input input::placeholder {
        color: #878A99;
    }

    .msg-new-chat {
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 37px;
        height: 37px;
        flex: none;
        background: #FFFFFF;
        border: 1px solid #1D4ED8;
        border-radius: 4px;
        color: #1D4ED8;
        font-size: 14px;
    }

    .msg-card__filters {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 14px 14px 0 16px;
        width: 100%;
    }

    .msg-tabs {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        padding: 3px;
        gap: 2px;
        height: 34px;
        background: rgba(233, 235, 236, 0.5);
        border-radius: 20px;
    }

    .msg-tab {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        height: 28px;
        border: 0;
        background: transparent;
        border-radius: 16px;
        font-size: 12.5px;
        line-height: 16px;
        color: #495057;
    }

    .msg-tab.is-active {
        background: #FFFFFF;
        box-shadow: 0px 1px 1px rgba(0, 0, 0, 0.06);
        color: #1D4ED8;
    }

    .msg-tab__badge {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0 5px;
        min-width: 15px;
        height: 15px;
        background: #1D4ED8;
        border-radius: 8px;
        font-size: 9px;
        line-height: 11px;
        color: #FFFFFF;
    }

    .msg-select-link {
        font-size: 13px;
        line-height: 16px;
        color: #878A99;
        text-decoration: none;
    }

    .msg-list {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        padding: 8px 8px 0;
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
    }

    .msg-list__label {
        display: flex;
        align-items: center;
        padding: 4px;
        width: 100%;
        font-size: 10.5px;
        line-height: 13px;
        letter-spacing: 0.525px;
        color: #878A99;
    }

    .msg-list__label.mt {
        padding: 10px 4px 4px;
    }

    .chat-item {
        position: relative;
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        padding: 10px 8px;
        gap: 10px;
        width: 100%;
        border-radius: 10px;
        cursor: pointer;
        text-decoration: none;
    }

    .chat-item:hover {
        background: rgba(233, 235, 236, 0.5);
    }

    .chat-item.is-active {
        background: rgba(29, 78, 216, 0.08);
        padding-left: 11px;
    }

    .chat-item.is-active::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: #1D4ED8;
        border-radius: 10px 0 0 10px;
    }

    .avatar {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 42px;
        height: 42px;
        flex: none;
        border-radius: 21px;
        font-size: 13px;
        line-height: 16px;
        color: #212529;
    }

    .avatar--sm {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        font-size: 9px;
        line-height: 10px;
    }

    .avatar-wrap {
        position: relative;
        flex: none;
    }

    .avatar-pin {
        box-sizing: border-box;
        position: absolute;
        right: -2px;
        bottom: -2px;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 15px;
        height: 15px;
        background: #1D4ED8;
        border: 2px solid #FFFFFF;
        border-radius: 7.5px;
        color: #FFFFFF;
        font-size: 7px;
    }

    .chat-item__body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 2px 0;
        gap: 4px;
        flex: 1 1 auto;
        min-width: 0;
    }

    .chat-item__top {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        gap: 8px;
    }

    .chat-item__name {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 16px;
        line-height: 21px;
        color: #212529;
        min-width: 0;
    }

    .chat-item__name i {
        font-size: 11px;
        color: #1D4ED8;
    }

    .chat-item__time {
        font-size: 11px;
        line-height: 21px;
        text-align: right;
        color: #878A99;
        white-space: nowrap;
    }

    .chat-item__subject {
        font-size: 14px;
        line-height: 21px;
        color: #212529;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .chat-item__preview {
        font-size: 12px;
        line-height: 21px;
        color: #878A99;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .chat-item__meta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
        width: 26px;
        flex: none;
    }

    .unread-dot {
        display: flex;
        justify-content: center;
        align-items: center;
        min-width: 16px;
        height: 16px;
        padding: 0 5px;
        background: #1D4ED8;
        border-radius: 24px;
        font-size: 8px;
        line-height: 10px;
        color: #FFFFFF;
    }

    .kebab {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 26px;
        height: 26px;
        border: 0;
        background: transparent;
        border-radius: 13px;
        color: #878A99;
        font-size: 18px;
        line-height: 1;
    }

    .kebab:hover {
        background: rgba(233, 235, 236, 0.8);
    }

    /* ------------------------------------------------------------- chat panel */
    .msg-chat {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        flex: 1 1 auto;
        min-width: 0;
        background: #FFFFFF;
        box-shadow: 0px 1px 3px rgba(22, 27, 34, 0.05), 0px 8px 20px rgba(22, 27, 34, 0.06);
        border-radius: 16px;
    }

    .chat-head {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 12px 24px;
        gap: 16px;
        width: 100%;
        height: 69px;
    }

    .chat-head__title {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 12px;
    }

    .chat-head__name {
        font-size: 20px;
        line-height: 25px;
        color: #212529;
    }

    .chat-head__members {
        font-size: 11px;
        line-height: 14px;
        color: #495057;
    }

    .icon-chip {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 24px;
        height: 24px;
        flex: none;
        background: rgba(29, 78, 216, 0.08);
        border: 0;
        border-radius: 12px;
        color: #212529;
        font-size: 12px;
    }

    .chat-head__tools {
        display: flex;
        flex-direction: row;
        justify-content: flex-end;
        align-items: center;
        gap: 16px;
        flex: 1 1 auto;
    }

    .chat-search {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 9px 14px;
        gap: 9px;
        width: 280px;
        height: 34px;
        background: #F5F6FA;
        border-radius: 10px;
    }

    .chat-search i {
        font-size: 14px;
        color: #8A93A6;
    }

    .chat-search input {
        border: 0;
        outline: 0;
        background: transparent;
        width: 100%;
        font-size: 13px;
        line-height: 16px;
        color: #212529;
    }

    .chat-search input::placeholder {
        color: #8A93A6;
    }

    .chat-head__actions {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 16px;
    }

    .chat-head__actions button {
        border: 0;
        background: transparent;
        padding: 0;
        width: 18px;
        height: 18px;
        line-height: 1;
        color: #212529;
        opacity: 0.95;
        font-size: 16px;
    }

    .pinned-bar {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 9px 24px 11px;
        gap: 10px;
        width: 100%;
        background: #EAF3FF;
    }

    .pinned-bar i {
        font-size: 14px;
        color: #1D4ED8;
    }

    .pinned-bar__text {
        flex: 1 1 auto;
        font-size: 12.5px;
        line-height: 16px;
        color: #161B22;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pinned-bar__close {
        border: 0;
        background: transparent;
        color: #8A93A6;
        font-size: 14px;
        line-height: 1;
        padding: 0;
    }

    .chat-stream {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 28px 24px;
        gap: 20px;
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        background: #F5F6FA;
    }

    .stream-note {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        font-size: 12px;
        line-height: 15px;
        text-align: center;
        color: #8A93A6;
    }

    .stream-day {
        padding: 4px 0;
    }

    .stream-divider {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 12px;
        width: 100%;
    }

    .stream-divider::before,
    .stream-divider::after {
        content: "";
        flex: 1 1 auto;
        height: 1px;
        background: #D3DAE6;
    }

    .stream-divider span {
        font-size: 12px;
        line-height: 14px;
        color: #8A93A6;
    }

    .msg-row {
        display: flex;
        flex-direction: row;
        align-items: flex-end;
        gap: 14px;
        max-width: 604px;
    }

    .msg-row--out {
        align-self: flex-end;
        flex-direction: row;
    }

    .msg-block {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
        position: relative;
        min-width: 0;
    }

    .msg-row--out .msg-block {
        align-items: flex-end;
    }

    .msg-author {
        font-size: 13.5px;
        line-height: 17px;
        color: #161B22;
    }

    .bubble {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 10px 16px;
        gap: 5px;
        max-width: 550px;
        background: #FFFFFF;
        box-shadow: 0px 1px 0.5px rgba(22, 27, 34, 0.05);
        border-radius: 16px 16px 16px 4px;
    }

    .bubble__text {
        font-size: 14px;
        line-height: 21px;
        color: #4A5468;
    }

    .bubble__meta {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 3px;
        width: 100%;
        font-size: 9px;
        line-height: 11px;
        color: #4A5468;
    }

    .bubble--out {
        background: #1D4ED8;
        border-radius: 16px 16px 4px 16px;
    }

    .bubble--out .bubble__text,
    .bubble--out .bubble__meta {
        color: #FFFFFF;
    }

    .bubble--out .bubble__meta {
        justify-content: flex-end;
    }

    .bubble--soft {
        background: #EAF3FF;
        border-radius: 16px 16px 4px 16px;
    }

    .bubble--soft .bubble__meta {
        justify-content: flex-end;
        color: #4A5468;
    }

    .reaction-chip {
        position: absolute;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2px;
        height: 20px;
        padding: 0 6px;
        bottom: -10px;
        background: #EAF3FF;
        box-shadow: 0px 1px 0.5px rgba(22, 27, 34, 0.08);
        border-radius: 13px;
        border: 0;
        font-size: 9px;
        line-height: 11px;
        color: #212529;
        z-index: 2;
    }

    .reaction-chip span.emoji {
        font-size: 12px;
        line-height: 14px;
    }

    .msg-block .reaction-chip {
        right: 16px;
    }

    .msg-row--out .reaction-chip {
        left: 16px;
        right: auto;
    }

    .msg-tools {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: 8px;
        width: 26px;
        flex: none;
        opacity: 0;
        transition: opacity .12s ease-in-out;
    }

    .msg-row:hover .msg-tools {
        opacity: 1;
    }

    .msg-tool {
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 24px;
        height: 24px;
        padding: 0;
        background: #FFFFFF;
        border: 1px solid #E9EBEC;
        border-radius: 12px;
        color: #878A99;
        font-size: 12px;
        line-height: 1;
    }

    .msg-react {
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 26px;
        height: 26px;
        padding: 0;
        background: #EAF3FF;
        border: 1px solid #1D4ED8;
        box-shadow: 0px 1px 0.5px rgba(22, 27, 34, 0.08);
        border-radius: 13px;
        font-size: 12px;
        line-height: 14px;
    }

    .msg-react--plain {
        background: #FFFFFF;
        border: 1px solid #CED4DA;
        box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.08);
    }

    /* -------------------------------------------------------------- composer */
    .chat-composer {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 18px 24px 16px;
        gap: 24px;
        width: 100%;
        height: 69px;
        background: #FFFFFF;
        border-top: 1px solid #E7EAF0;
        border-radius: 0 0 16px 16px;
    }

    .composer-tools {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 24px;
        height: 24px;
    }

    .composer-tool {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 24px;
        height: 24px;
        padding: 0;
        border: 0;
        background: transparent;
        color: #4A5468;
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
    }

    .composer-divider {
        width: 1px;
        height: 24px;
        background: #E9EBEC;
    }

    .composer-input {
        flex: 1 1 auto;
        border: 0;
        outline: 0;
        resize: none;
        height: 24px;
        font-size: 14px;
        line-height: 18px;
        color: #212529;
        font-family: inherit;
    }

    .composer-input::placeholder {
        color: #8A93A6;
    }

    .composer-send {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 34px;
        height: 34px;
        flex: none;
        border: 0;
        background: #1D4ED8;
        border-radius: 17px;
        color: #FFFFFF;
        font-size: 16px;
    }

    /* ------------------------------------------------------- menus / popovers */
    .msg-menu {
        box-sizing: border-box;
        display: none;
        flex-direction: column;
        align-items: flex-start;
        padding: 6px;
        position: absolute;
        width: 180px;
        background: #FFFFFF;
        border: 1px solid #CED4DA;
        box-shadow: 0px 6px 18px rgba(0, 0, 0, 0.14);
        border-radius: 8px;
        z-index: 1050;
    }

    .msg-menu.is-open {
        display: flex;
    }

    .msg-menu__item {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 8px 10px;
        gap: 8px;
        width: 100%;
        border: 0;
        background: transparent;
        border-radius: 6px;
        font-size: 13px;
        line-height: 16px;
        color: #212529;
        text-align: left;
    }

    .msg-menu__item:hover {
        background: rgba(233, 235, 236, 0.6);
    }

    .msg-menu__item i {
        font-size: 13px;
    }

    .msg-menu__item--danger {
        color: #E0431F;
    }

    .msg-menu__divider {
        width: calc(100% - 8px);
        height: 1px;
        margin: 6px 4px;
        background: #E9EBEC;
    }

    .react-list {
        box-sizing: border-box;
        display: none;
        flex-direction: column;
        align-items: flex-start;
        padding: 8px;
        position: absolute;
        width: 190px;
        background: #FFFFFF;
        border: 1px solid #CED4DA;
        box-shadow: 0px 8px 22px rgba(0, 0, 0, 0.16);
        border-radius: 8px;
        z-index: 1060;
    }

    .react-list.is-open {
        display: flex;
    }

    .react-list__head {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 2px 4px 6px;
        gap: 5px;
        width: 100%;
        font-size: 11px;
        line-height: 14px;
        letter-spacing: 0.33px;
        text-transform: uppercase;
        color: #878A99;
    }

    .react-list__body {
        width: 100%;
        max-height: 220px;
        overflow-y: auto;
    }

    .react-list__row {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 5px 4px;
        gap: 8px;
        height: 30px;
        font-size: 12.5px;
        line-height: 16px;
        color: #212529;
    }

    /* --------------------------------------------------------------- responsive */
    @@media (max-width: 991.98px) {
        .msg-layout {
            flex-direction: column;
            height: auto;
        }

        .msg-sidebar {
            width: 100%;
        }

        .msg-card {
            height: 520px;
        }

        .msg-chat {
            width: 100%;
            height: 640px;
        }
    }
</style>

