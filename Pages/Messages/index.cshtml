                const open = peopleModal.classList.toggle('is-open');
                if (!open) return;
                const rect = addPeopleBtn.getBoundingClientRect();
                let top = rect.bottom + 6;
                if (top + peopleModal.offsetHeight > window.innerHeight - 8) {
                    top = Math.max(8, window.innerHeight - peopleModal.offsetHeight - 8);
                }
                peopleModal.style.top = top + 'px';
                peopleModal.style.left =
                    Math.max(8, rect.left - peopleModal.offsetWidth - 8) + 'px';
                refreshPeopleCount();
