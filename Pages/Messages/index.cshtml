        // ---------------------------------------------------- add people modal
        const peopleModal = document.getElementById('peopleModal');
        const addPeopleBtn = document.getElementById('addPeopleBtn');
        const listUsers = document.getElementById('peopleListUsers');
        const listGroups = document.getElementById('peopleListGroups');
        const peopleAll = document.getElementById('peopleAll');
        const peopleAllLabel = document.getElementById('peopleAllLabel');
        const peopleCount = document.getElementById('peopleCount');
        const peopleSearch = document.getElementById('peopleSearch');

        const activeList = () => listGroups.style.display === 'none' ? listUsers : listGroups;

        const refreshPeopleCount = () => {
            const list = activeList();
            const boxes = [...list.querySelectorAll('.people-check')];
            const picked = boxes.filter(b => b.checked).length;
            peopleCount.textContent = picked + ' selected';
            peopleAll.checked = picked > 0 && picked === boxes.length;
