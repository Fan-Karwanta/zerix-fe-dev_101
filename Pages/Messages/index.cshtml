                    href="#" id="navbarDropDownMessages" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="~/images/icons/messages.svg" height="30" width="30" alt="Logo"
                        class="d-inline-block align-top me-2 color-primary" />
                    <span class="txt-color-primary fs-20 fw-400 me-3 text-brand">Messages</span>
                    <img src="~/images/icons/arrow-down.svg" height="12" width="12" alt="arrow-down"
                        class="d-inline-block" />
                </a>
                <ul class="dropdown-menu dropdown-menu-lg ud-shadow bg-body-tertiary rounded border-0"
