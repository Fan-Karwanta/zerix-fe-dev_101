@section Scripts {
<script>
    (function () {
        const closeAllOverlays = (except) => {
            document.querySelectorAll('.msg-menu.is-open, .react-list.is-open').forEach(el => {
                if (el !== except) el.classList.remove('is-open');
            });
        };

        const placeOverlay = (overlay, anchor) => {
            const rect = anchor.getBoundingClientRect();
            overlay.classList.add('is-open');
            const width = overlay.offsetWidth;
            const height = overlay.offsetHeight;
            let left = rect.right - width;
            let top = rect.bottom + window.scrollY + 6;
            if (left < 8) left = 8;
            if (rect.bottom + height + 12 > window.innerHeight) {
                top = rect.top + window.scrollY - height - 6;
            }
            overlay.style.position = 'absolute';
            overlay.style.left = left + window.scrollX + 'px';
            overlay.style.top = top + 'px';
        };

        // Context menus (chat list kebab + message kebabs)
        document.addEventListener('click', (e) => {
            const trigger = e.target.closest('[data-menu]');
            if (trigger) {
                e.preventDefault();
                e.stopPropagation();
                const menu = document.getElementById(trigger.dataset.menu);
                if (!menu) return;
                const wasOpen = menu.classList.contains('is-open');
                closeAllOverlays();
                if (!wasOpen) placeOverlay(menu, trigger);
                return;
            }

            if (!e.target.closest('.msg-menu') && !e.target.closest('.react-list')) {
                closeAllOverlays();
            }
        });

        // Company selector
        const companySelect = document.getElementById('companySelect');
        const companyMenu = document.getElementById('companyMenu');
        if (companySelect && companyMenu) {
            companySelect.addEventListener('click', (e) => {
                if (e.target.closest('.msg-menu__item')) {
                    companySelect.querySelector('.company-select__label').lastChild.textContent =
                        ' ' + e.target.textContent.trim();
                    companyMenu.classList.remove('is-open');
                    return;
                }
                const wasOpen = companyMenu.classList.contains('is-open');
                closeAllOverlays();
                companyMenu.style.position = 'absolute';
                companyMenu.style.top = '53px';
                companyMenu.style.left = '0';
                companyMenu.classList.toggle('is-open', !wasOpen);
            });
        }

        // Reaction list popover
        const reactList = document.getElementById('reactList');
        document.querySelectorAll('[data-react-list]').forEach(chip => {
            chip.addEventListener('mouseenter', () => {
                closeAllOverlays(reactList);
                placeOverlay(reactList, chip);
            });
            chip.addEventListener('click', (e) => {
                e.stopPropagation();
                closeAllOverlays(reactList);
                placeOverlay(reactList, chip);
            });
        });
        if (reactList) {
            reactList.addEventListener('mouseleave', () => reactList.classList.remove('is-open'));
        }

        // Filter tabs
        const chatList = document.getElementById('chatList');
        document.querySelectorAll('.msg-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.msg-tab').forEach(t => t.classList.remove('is-active'));
                tab.classList.add('is-active');
                const filter = tab.dataset.filter;
                chatList.querySelectorAll('.chat-item').forEach(item => {
                    const show = filter === 'all'
                        || (filter === 'unread' && item.dataset.unread !== '0')
                        || (filter === 'groups' && item.dataset.type === 'group');
                    item.style.display = show ? '' : 'none';
                });
                chatList.querySelectorAll('.msg-list__label').forEach(label => {
                    label.style.display = filter === 'all' ? '' : 'none';
                });
            });
        });

        // Chat list search
        const listSearch = document.getElementById('chatListSearch');
        if (listSearch) {
            listSearch.addEventListener('input', () => {
                const term = listSearch.value.trim().toLowerCase();
                chatList.querySelectorAll('.chat-item').forEach(item => {
                    item.style.display = item.textContent.toLowerCase().includes(term) ? '' : 'none';
                });
            });
        }

        // ------------------------------------------------ conversation switching
        // One shared chat header / pinned bar / composer drives every conversation;
        // only the message stream is swapped. Keys match data-conv on the chat list
        // items and data-conv-stream on the streams.
        const CONVERSATIONS = {
            'hr-team': {
                initials: 'HT', colour: '#FFB199', name: 'HR Team', sub: '12 members', isGroup: true,
                pinned: "Pinned message · We'll cover project updates, upcoming deadlines, and brainstorming ideas for the new campaign."
            },
            'clint': {
                initials: 'CB', colour: '#FFD59E', name: 'Clint Barton', sub: 'Active now', isGroup: false,
                pinned: null
            },
            'natasha': {
                initials: 'NR', colour: '#B8E0D2', name: 'Natasha Romanoff', sub: 'Active 5m ago', isGroup: false,
                pinned: null
            },
            'maria': {
                initials: 'MR', colour: '#FFB199', name: 'Maria Reyes', sub: 'Active 2h ago', isGroup: false,
                pinned: null
            },
            'design-team': {
                initials: 'DT', colour: '#B7C9F2', name: 'Design Team', sub: '8 members', isGroup: true,
                pinned: 'Pinned message · Component library lives in Figma — always branch before editing.'
            }
        };

        let activeConv = 'hr-team';
        const convStreams = document.querySelectorAll('.chat-stream[data-conv-stream]');
        const headAvatar = document.getElementById('chatHeadAvatar');
        const headName = document.getElementById('chatHeadName');
        const headSub = document.getElementById('chatHeadSub');
        const pinnedBar = document.getElementById('pinnedBar');
        const pinnedBarText = document.getElementById('pinnedBarText');
        const dismissedPins = new Set();

        const applyPinnedBar = (convKey) => {
            const meta = CONVERSATIONS[convKey];
            if (!pinnedBar) return;
            const show = !!(meta && meta.pinned) && !dismissedPins.has(convKey);
            pinnedBar.hidden = !show;
            if (show) pinnedBarText.textContent = meta.pinned;
        };

        // the unread pill in the filter tabs should track the list, not a fixed number
        const refreshUnreadBadge = () => {
            const badge = document.querySelector('.msg-tab__badge');
            if (!badge || !chatList) return;
            const count = chatList.querySelectorAll('.chat-item[data-unread]:not([data-unread="0"])').length;
            badge.textContent = count;
            badge.hidden = count === 0;
        };

        const switchConversation = (convKey) => {
            const meta = CONVERSATIONS[convKey];
            if (!meta || convKey === activeConv) return;
            activeConv = convKey;

            // header
            headAvatar.textContent = meta.initials;
            headAvatar.style.background = meta.colour;
            headName.textContent = meta.name;
            headSub.textContent = meta.sub;

            // group-only affordances (rename, members panel)
            document.querySelectorAll('.is-group-only').forEach(el => { el.hidden = !meta.isGroup; });
            if (meta.isGroup) {
                const title = document.getElementById('membersPanelTitle');
                const count = document.getElementById('membersPanelCount');
                if (title) title.textContent = meta.name;
                if (count) count.textContent = parseInt(meta.sub, 10) || '';
            }

            applyPinnedBar(convKey);

            // swap the stream and re-point the composer + search at it
            convStreams.forEach(s => { s.hidden = s.dataset.convStream !== convKey; });
            stream = document.querySelector('.chat-stream[data-conv-stream="' + convKey + '"]');
            streamEmpty = stream ? stream.querySelector('.stream-empty') : null;

            // a search from the previous conversation must not leak into this one
            resetConversationSearch();

            // side panels belong to the conversation we just left
            document.querySelectorAll('.members-panel.is-open').forEach(p => p.classList.remove('is-open'));

            if (stream) stream.scrollTop = stream.scrollHeight;
        };

        chatList && chatList.addEventListener('click', (e) => {
            const item = e.target.closest('.chat-item');
            if (!item || e.target.closest('[data-menu]')) return;

            chatList.querySelectorAll('.chat-item').forEach(i => i.classList.remove('is-active'));
            item.classList.add('is-active');

            // opening a conversation marks it read
            if (item.dataset.unread !== '0') {
                item.dataset.unread = '0';
                const dot = item.querySelector('.unread-dot');
                if (dot) dot.remove();
                const preview = item.querySelector('.chat-item__preview');
                if (preview) preview.style.removeProperty('color');
                refreshUnreadBadge();
            }

            if (item.dataset.conv) switchConversation(item.dataset.conv);
        });

        // Dismiss pinned banner — hide rather than remove so other conversations keep theirs
        const pinnedClose = document.querySelector('.pinned-bar__close');
        if (pinnedClose) {
            pinnedClose.addEventListener('click', () => {
                dismissedPins.add(activeConv);
                applyPinnedBar(activeConv);
            });
        }

        // Composer
        const composer = document.getElementById('composerInput');
        const sendBtn = document.getElementById('composerSend');
        let stream = document.getElementById('chatStream');

        const sendMessage = () => {
            const text = composer.value.trim();
            if (!text) return;
            const time = new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
            const row = document.createElement('div');
            row.className = 'msg-row msg-row--out';
            row.innerHTML =
                '<div class="msg-tools">' +
                '<button type="button" class="msg-tool" data-menu="myMessageMenu"><i class="bi bi-three-dots-vertical"></i></button>' +
                '<button type="button" class="msg-react msg-react--plain">&#129309;</button>' +
                '</div>' +
                '<div class="msg-block"><div class="bubble bubble--out">' +
                '<span class="bubble__text"></span>' +
                '<span class="bubble__meta">' + time + ' <i class="bi bi-check2"></i></span>' +
                '</div></div>';
            row.querySelector('.bubble__text').textContent = text;
            stream.appendChild(row);
            composer.value = '';
            composer.style.height = '24px';
            stream.scrollTop = stream.scrollHeight;
        };

        sendBtn && sendBtn.addEventListener('click', sendMessage);
        composer && composer.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });
        composer && composer.addEventListener('input', () => {
            composer.style.height = '24px';
            composer.style.height = Math.min(composer.scrollHeight, 96) + 'px';
        });

        // ----------------------------------------------------------- voice to text
        const voiceToggle = document.getElementById('voiceToggle');
        const voiceRec = document.getElementById('voiceRec');
        const voiceTime = document.getElementById('voiceTime');
        const voiceCancel = document.getElementById('voiceCancel');
        const voiceSendBtn = document.getElementById('voiceSend');

        let voiceTimer = null;
        let voiceSeconds = 0;
        let voiceBaseline = '';   // composer text before dictation started
        let voiceWordIndex = 0;

        // stand-in for the speech engine: words land in the composer one by one so
        // the user can read the transcription before sending it
        const DICTATION_WORDS = ('Noted, I will review the deck and send my comments before ' +
            'the end of the day. Thanks!').split(' ');

        const fmtDuration = (total) =>
            Math.floor(total / 60) + ':' + String(total % 60).padStart(2, '0');

        const stopVoiceUI = () => {
            clearInterval(voiceTimer);
            voiceTimer = null;
            voiceRec.classList.remove('is-open');
            voiceToggle.classList.remove('is-active');
        };

        const resizeComposer = () => {
            if (!composer) return;
            composer.style.height = '24px';
            composer.style.height = Math.min(composer.scrollHeight, 96) + 'px';
        };

        const startVoice = () => {
            voiceSeconds = 0;
            voiceWordIndex = 0;
            voiceBaseline = composer ? composer.value : '';
            voiceTime.textContent = '0:00';
            voiceRec.classList.add('is-open');
            voiceToggle.classList.add('is-active');
            composer && composer.focus();

            voiceTimer = setInterval(() => {
                voiceSeconds++;
                voiceTime.textContent = fmtDuration(voiceSeconds);

                if (composer && voiceWordIndex < DICTATION_WORDS.length) {
                    const prefix = composer.value && !/\s$/.test(composer.value) ? ' ' : '';
                    composer.value += prefix + DICTATION_WORDS[voiceWordIndex++];
                    resizeComposer();
                }

                if (voiceSeconds >= 300) finishVoice(); // 5 min cap
            }, 1000);
        };

        // stop listening and send whatever was transcribed
        const finishVoice = () => {
            stopVoiceUI();
            sendMessage();
        };

        // stop listening and throw the transcription away
        const discardVoice = () => {
            stopVoiceUI();
            if (composer) {
                composer.value = voiceBaseline;
                resizeComposer();
            }
        };

        if (voiceToggle && voiceRec) {
            voiceToggle.addEventListener('click', () => {
                if (voiceTimer) { stopVoiceUI(); return; }
                startVoice();
            });
            voiceCancel.addEventListener('click', discardVoice);
            voiceSendBtn.addEventListener('click', finishVoice);
        }

        // play/pause toggle on any voice note in the stream
        stream && stream.addEventListener('click', (e) => {
            const play = e.target.closest('.voice-note__play');
            if (!play) return;
            const icon = play.querySelector('i');
            const playing = icon.classList.contains('bi-pause-fill');
            icon.className = playing ? 'bi bi-play-fill' : 'bi bi-pause-fill';
        });

        // ------------------------------------------------------- members panel
        const membersPanel = document.getElementById('membersPanel');
        const peopleToggle = document.getElementById('peopleToggle');
        const closeMembers = () => membersPanel && membersPanel.classList.remove('is-open');

        peopleToggle && peopleToggle.addEventListener('click', () => {
            membersPanel.classList.toggle('is-open');
