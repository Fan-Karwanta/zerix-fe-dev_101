@page
@model MessageIndexModel
@{
Layout = "_Messages";
ViewData["Title"] = "Messages";
ViewData["User"] = "Admin";
}

<style>
    /* ==========================================================================
       Messaging (Group Chat) — Figma
       ========================================================================== */
    .msg-page {
        background: #F5F6FD;
        font-family: 'Plus Jakarta Sans', sans-serif;
        padding-bottom: 40px;
        min-height: calc(100vh - 188px);
    }

    .msg-layout {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        gap: 32px;
        padding-top: 24px;
        height: 787px;
    }

    /* ---------------------------------------------------------------- sidebar */
    .msg-sidebar {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
        width: 346px;
        flex: none;
    }

    .company-select {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 14px 18px;
        width: 100%;
        height: 49px;
        background: #FFFFFF;
        border: 1px solid #D3DAE6;
        border-radius: 10px;
        cursor: pointer;
        position: relative;
    }

    .company-select__label {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 9px;
        font-size: 15px;
        line-height: 19px;
        color: #161B22;
    }

    .company-select__label i {
        font-size: 17px;
        color: #4A5468;
    }

    .company-select__caret {
        font-size: 12px;
        color: #161B22;
    }

    .msg-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 0 0 20px;
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
        background: #FFFFFF;
        box-shadow: 0px 1px 3px rgba(22, 27, 34, 0.05), 0px 8px 20px rgba(22, 27, 34, 0.06);
        border-radius: 16px;
    }

    .msg-card__search {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        padding: 16px 16px 0;
        gap: 10px;
        width: 100%;
    }

    .msg-search-input {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 1px 14px;
        gap: 10px;
        height: 37px;
        flex: 1 1 auto;
        border: 1px solid #CED4DA;
        border-radius: 4px;
    }

    .msg-search-input i {
        font-size: 15px;
        color: #878A99;
    }

    .msg-search-input input {
        border: 0;
        outline: 0;
        width: 100%;
        font-size: 14px;
        line-height: 16px;
        color: #212529;
        background: transparent;
    }

    .msg-search-input input::placeholder {
        color: #878A99;
    }

    .msg-new-chat {
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 37px;
        height: 37px;
        flex: none;
        background: #FFFFFF;
        border: 1px solid #1D4ED8;
        border-radius: 4px;
        color: #1D4ED8;
        font-size: 14px;
    }

    .msg-card__filters {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 14px 14px 0 16px;
        width: 100%;
    }

    .msg-tabs {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        padding: 3px;
        gap: 2px;
        height: 34px;
        background: rgba(233, 235, 236, 0.5);
        border-radius: 20px;
    }

    .msg-tab {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        height: 28px;
        border: 0;
        background: transparent;
        border-radius: 16px;
        font-size: 12.5px;
        line-height: 16px;
        color: #495057;
    }

    .msg-tab.is-active {
        background: #FFFFFF;
        box-shadow: 0px 1px 1px rgba(0, 0, 0, 0.06);
        color: #1D4ED8;
    }

    .msg-tab__badge {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0 5px;
        min-width: 15px;
        height: 15px;
        background: #1D4ED8;
        border-radius: 8px;
        font-size: 9px;
        line-height: 11px;
        color: #FFFFFF;
    }

    .msg-select-link {
        font-size: 13px;
        line-height: 16px;
        color: #878A99;
        text-decoration: none;
    }

    .msg-list {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        padding: 8px 8px 0;
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        scrollbar-gutter: stable;
        scrollbar-width: thin;
        scrollbar-color: transparent transparent;
        transition: scrollbar-color .18s ease-in-out;
    }

    .msg-list:hover,
    .msg-list:focus-within {
        scrollbar-color: #C4CAD6 transparent;
    }

    .msg-list::-webkit-scrollbar {
        width: 10px;
    }

    .msg-list::-webkit-scrollbar-track {
        background: transparent;
    }

    .msg-list::-webkit-scrollbar-thumb {
        background: transparent;
        border: 3px solid transparent;
        background-clip: content-box;
        border-radius: 5px;
    }

    .msg-list:hover::-webkit-scrollbar-thumb,
    .msg-list:focus-within::-webkit-scrollbar-thumb {
        background: #C4CAD6;
        background-clip: content-box;
    }

    .msg-list:hover::-webkit-scrollbar-thumb:hover {
        background: #A9B1C1;
        background-clip: content-box;
    }

    .msg-list__label {
        display: flex;
        align-items: center;
        padding: 4px;
        width: 100%;
        font-size: 10.5px;
        line-height: 13px;
        letter-spacing: 0.525px;
        color: #878A99;
    }

    .msg-list__label.mt {
        padding: 10px 4px 4px;
    }

    .chat-item {
        position: relative;
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        padding: 10px 8px;
        gap: 10px;
        width: 100%;
        border-radius: 10px;
        cursor: pointer;
        text-decoration: none;
    }

    .chat-item:hover {
        background: rgba(233, 235, 236, 0.5);
    }

    .chat-item.is-active {
        background: rgba(29, 78, 216, 0.08);
        padding-left: 11px;
    }

    .chat-item.is-active::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: #1D4ED8;
        border-radius: 10px 0 0 10px;
    }

    .avatar {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 42px;
        height: 42px;
        flex: none;
        border-radius: 21px;
        font-size: 13px;
        line-height: 16px;
        color: #212529;
    }

    .avatar--sm {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        font-size: 9px;
        line-height: 10px;
    }

    .avatar-wrap {
        position: relative;
        flex: none;
    }

    .avatar-pin {
        box-sizing: border-box;
        position: absolute;
        right: -2px;
        bottom: -2px;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 15px;
        height: 15px;
        background: #1D4ED8;
        border: 2px solid #FFFFFF;
        border-radius: 7.5px;
        color: #FFFFFF;
        font-size: 7px;
    }

    .chat-item__body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 2px 0;
        gap: 4px;
        flex: 1 1 auto;
        min-width: 0;
    }

    .chat-item__top {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        gap: 8px;
    }

    .chat-item__name {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 16px;
        line-height: 21px;
        color: #000000;
        min-width: 0;
    }

    .chat-item__name i {
        font-size: 11px;
        color: #1D4ED8;
    }

    .chat-item__time {
        font-size: 11px;
        line-height: 21px;
        text-align: right;
        color: #878A99;
        white-space: nowrap;
    }

    .chat-item__subject {
        font-size: 14px;
        line-height: 21px;
        color: #212529;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .chat-item__preview {
        font-size: 12px;
        line-height: 21px;
        color: #878A99;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .chat-item__meta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
        width: 26px;
        flex: none;
    }

    /* ------------------------------------------------- unread state (inbox list) */
    /* an unread thread has to read as unread at a glance: tinted row, bold name,
       dark preview text and a blue count badge */
    .chat-item[data-unread]:not([data-unread="0"]) {
        background: #EFF6FF;
    }

    .chat-item[data-unread]:not([data-unread="0"]):hover {
        background: #E1EDFE;
    }

    .chat-item[data-unread]:not([data-unread="0"]).is-active {
        background: rgba(29, 78, 216, 0.08);
    }

    .chat-item[data-unread]:not([data-unread="0"]) .chat-item__name,
    .chat-item[data-unread]:not([data-unread="0"]) .chat-item__subject {
        font-weight: 700;
        color: #161B22;
    }

    .chat-item[data-unread]:not([data-unread="0"]) .chat-item__preview {
        font-weight: 600;
        color: #212529;
    }

    .chat-item[data-unread]:not([data-unread="0"]) .chat-item__time {
        font-weight: 600;
        color: #1D4ED8;
    }

    .unread-dot {
        display: flex;
        justify-content: center;
        align-items: center;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        background: #1D4ED8;
        border-radius: 24px;
        font-size: 10px;
        font-weight: 700;
        line-height: 18px;
        color: #FFFFFF;
    }

    .kebab {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 26px;
        height: 26px;
        border: 0;
        background: transparent;
        border-radius: 13px;
        color: #878A99;
        font-size: 18px;
        line-height: 1;
    }

    .kebab:hover {
        background: rgba(233, 235, 236, 0.8);
    }

    /* ------------------------------------------------------------- chat panel */
    .msg-chat {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        flex: 1 1 auto;
        min-width: 0;
        background: #FFFFFF;
        border: 1px solid #E7EAF0;
        border-radius: 16px;
    }

    /* a 1-to-1 thread has only one other participant, so the sender label above
       each incoming bubble is redundant */
    .chat-stream--direct .msg-author {
        display: none;
    }

    /* only one conversation stream is mounted at a time; [hidden] needs to beat
       the display:flex on .chat-stream */
    .chat-stream[hidden],
    .is-group-only[hidden] {
        display: none !important;
    }

    .chat-head {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 12px 24px;
        gap: 16px;
        width: 100%;
        height: 69px;
    }

    .chat-head__title {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 12px;
    }

    .chat-head__name {
        font-size: 20px;
        line-height: 25px;
        font-weight: 600;
        color: #000000;
    }

    .chat-head__members {
        font-size: 11px;
        line-height: 14px;
        color: #495057;
    }

    .icon-chip {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 24px;
        height: 24px;
        flex: none;
        background: rgba(29, 78, 216, 0.08);
        border: 0;
        border-radius: 12px;
        color: #212529;
        font-size: 12px;
        line-height: 1;
    }

    .icon-chip i {
        display: block;
        line-height: 1;
    }

    .chat-head__tools {
        display: flex;
        flex-direction: row;
        justify-content: flex-end;
        align-items: center;
        gap: 16px;
        flex: 1 1 auto;
    }

    .chat-search {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 9px 14px;
        gap: 9px;
        width: 280px;
        height: 34px;
        background: #F5F6FA;
        border-radius: 10px;
    }

    .chat-search i {
        font-size: 14px;
        color: #8A93A6;
    }

    .chat-search input {
        border: 0;
        outline: 0;
        background: transparent;
        width: 100%;
        font-size: 13px;
        line-height: 16px;
        color: #212529;
    }

    .chat-search input::placeholder {
        color: #8A93A6;
    }

    .chat-search.is-active {
        background: #FFFFFF;
        box-shadow: inset 0 0 0 1px #1D4ED8;
    }

    /* ------------------------------------------------- search in conversation */
    .chat-search__count {
        display: flex;
        align-items: center;
        align-self: center;
        flex: none;
        height: 18px;
        font-size: 11px;
        line-height: 1;
        color: #8A93A6;
        white-space: nowrap;
    }

    .chat-search__nav {
        display: none;
        align-items: center;
        align-self: center;
        gap: 2px;
        flex: none;
    }

    .chat-search.is-active .chat-search__nav {
        display: flex;
    }

    .chat-search__nav button {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 18px;
        height: 18px;
        padding: 0;
        border: 0;
        background: transparent;
        border-radius: 4px;
        color: #4A5468;
        font-size: 10px;
    }

    /* bootstrap-icons carry their own line-height, which pushes glyphs off-centre */
    .chat-search__nav button i {
        display: block;
        line-height: 1;
    }

    .chat-search__nav button:hover:not(:disabled) {
        background: #E9EBEC;
    }

    .chat-search__nav button:disabled {
        opacity: .35;
    }

    /* rows filtered out by the conversation search */
    .msg-row.is-filtered,
    .stream-note.is-filtered,
    .stream-divider.is-filtered {
        display: none;
    }

    .chat-stream mark.msg-hit {
        padding: 0 1px;
        background: #FFE9A8;
        border-radius: 2px;
        color: inherit;
    }

    .chat-stream mark.msg-hit.is-current {
        background: #FFC53D;
        box-shadow: 0 0 0 1.5px rgba(29, 78, 216, .55);
    }

    .bubble--out mark.msg-hit {
        background: #FFD966;
        color: #161B22;
    }

    .stream-empty {
        display: none;
        width: 100%;
        padding: 28px 0;
        text-align: center;
        font-size: 13px;
        line-height: 18px;
        color: #8A93A6;
    }

    .stream-empty.is-shown {
        display: block;
    }

    .chat-head__actions {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 16px;
    }

    .chat-head__actions button {
        border: 0;
        background: transparent;
        padding: 0;
        width: 18px;
        height: 18px;
        line-height: 1;
        color: #212529;
        opacity: 0.95;
        font-size: 16px;
    }

    .pinned-bar {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 9px 24px 11px;
        gap: 10px;
        width: 100%;
        background: #EAF3FF;
    }

    .pinned-bar i {
        font-size: 14px;
        color: #1D4ED8;
    }

    .pinned-bar__text {
        flex: 1 1 auto;
        font-size: 12.5px;
        line-height: 16px;
        color: #161B22;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pinned-bar__close {
        border: 0;
        background: transparent;
        color: #8A93A6;
        font-size: 14px;
        line-height: 1;
        padding: 0;
    }

    .chat-stream {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 28px 24px;
        gap: 20px;
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        background: #F5F6FA;
        /* auto-hiding scrollbar: reserve the gutter so nothing shifts on hover */
        scrollbar-gutter: stable;
        scrollbar-width: thin;
        scrollbar-color: transparent transparent;
        transition: scrollbar-color .18s ease-in-out;
    }

    .chat-stream:hover,
    .chat-stream:focus-within {
        scrollbar-color: #C4CAD6 transparent;
    }

    .chat-stream::-webkit-scrollbar {
        width: 10px;
    }

    .chat-stream::-webkit-scrollbar-track {
        background: transparent;
    }

    .chat-stream::-webkit-scrollbar-thumb {
        background: transparent;
        border: 3px solid transparent;
        background-clip: content-box;
        border-radius: 5px;
    }

    .chat-stream:hover::-webkit-scrollbar-thumb,
    .chat-stream:focus-within::-webkit-scrollbar-thumb {
        background: #C4CAD6;
        background-clip: content-box;
    }

    .chat-stream:hover::-webkit-scrollbar-thumb:hover {
        background: #A9B1C1;
        background-clip: content-box;
    }

    .stream-note {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        font-size: 12px;
        line-height: 15px;
        text-align: center;
        color: #8A93A6;
    }

    .stream-day {
        padding: 4px 0;
    }

    .stream-divider {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 12px;
        width: 100%;
    }

    .stream-divider::before,
    .stream-divider::after {
        content: "";
        flex: 1 1 auto;
        height: 1px;
        background: #D3DAE6;
    }

    .stream-divider span {
        font-size: 12px;
        line-height: 14px;
        color: #8A93A6;
    }

    .msg-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 14px;
        max-width: 604px;
    }

    .msg-row--out {
        align-self: flex-end;
        flex-direction: row;
    }

    .msg-block {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
        position: relative;
        min-width: 0;
    }

    .msg-row--out .msg-block {
        align-items: flex-end;
    }

    .msg-author {
        font-size: 13.5px;
        line-height: 17px;
        color: #000000;
    }

    .bubble {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 10px 16px;
        gap: 5px;
        max-width: 550px;
        background: #FFFFFF;
        box-shadow: 0px 1px 0.5px rgba(22, 27, 34, 0.05);
        border-radius: 16px 16px 16px 4px;
    }

    .bubble__text {
        font-size: 14px;
        line-height: 21px;
        color: #000000;
        /* keep the message exactly as the user typed it: newlines + runs of spaces */
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        max-width: 100%;
    }

    .bubble__meta {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 3px;
        width: 100%;
        font-size: 9px;
        line-height: 11px;
        color: #4A5468;
    }

    .bubble--out {
        background: #1D4ED8;
        border-radius: 16px 16px 4px 16px;
    }

    .bubble--out .bubble__text,
    .bubble--out .bubble__meta {
        color: #FFFFFF;
    }

    .bubble--out .bubble__meta {
        justify-content: flex-end;
    }

    .bubble--soft {
        background: #EAF3FF;
        border-radius: 16px 16px 4px 16px;
    }

    .bubble--soft .bubble__meta {
        justify-content: flex-end;
        color: #4A5468;
    }

    .reaction-chip {
        position: absolute;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2px;
        height: 20px;
        padding: 0 6px;
        bottom: -10px;
        background: #EAF3FF;
        box-shadow: 0px 1px 0.5px rgba(22, 27, 34, 0.08);
        border-radius: 13px;
        border: 0;
        font-size: 9px;
        line-height: 11px;
        color: #212529;
        z-index: 2;
    }

    .reaction-chip span.emoji {
        font-size: 12px;
        line-height: 14px;
    }

    .msg-block .reaction-chip {
        right: 16px;
    }

    .msg-row--out .reaction-chip {
        left: 16px;
        right: auto;
    }

    .msg-tools {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: 8px;
        width: 26px;
        flex: none;
        opacity: 0;
        transition: opacity .12s ease-in-out;
    }

    .msg-row:hover .msg-tools {
        opacity: 1;
    }

    .msg-tool {
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 24px;
        height: 24px;
        padding: 0;
        background: #FFFFFF;
        border: 1px solid #E9EBEC;
        border-radius: 12px;
        color: #878A99;
        font-size: 12px;
        line-height: 1;
    }

    .msg-react {
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 26px;
        height: 26px;
        padding: 0;
        background: #EAF3FF;
        border: 1px solid #1D4ED8;
        box-shadow: 0px 1px 0.5px rgba(22, 27, 34, 0.08);
        border-radius: 13px;
        font-size: 12px;
        line-height: 14px;
    }

    .msg-react--plain {
        background: #FFFFFF;
        border: 1px solid #CED4DA;
        box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.08);
    }

    /* -------------------------------------------------------------- composer */
    .chat-composer {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 18px 24px 16px;
        gap: 24px;
        width: 100%;
        height: 69px;
        background: #FFFFFF;
        border-top: 1px solid #E7EAF0;
        border-radius: 0 0 16px 16px;
    }

    .composer-tools {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 24px;
        height: 24px;
    }

    .composer-tool {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 24px;
        height: 24px;
        padding: 0;
        border: 0;
        background: transparent;
        color: #4A5468;
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
    }

    .composer-divider {
        width: 1px;
        height: 24px;
        background: #E9EBEC;
    }

    .composer-input {
        flex: 1 1 auto;
        border: 0;
        outline: 0;
        resize: none;
        height: 24px;
        font-size: 14px;
        line-height: 18px;
        color: #212529;
        font-family: inherit;
    }

    .composer-input::placeholder {
        color: #8A93A6;
    }

    .composer-send {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 34px;
        height: 34px;
        flex: none;
        border: 0;
        background: #1D4ED8;
        border-radius: 17px;
        color: #FFFFFF;
        font-size: 16px;
    }

    .composer-tool.is-active {
        color: #1D4ED8;
    }

    /* ------------------------------------------- voice to text (composer banner) */
    /* this is voice-to-text, so the bar sits ABOVE the input row and the input
       stays visible — the user has to see the text the speech converts to */
    .voice-rec {
        display: none;
        flex-direction: row;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding-bottom: 10px;
        margin-bottom: 10px;
        border-bottom: 1px solid #E7EAF0;
    }

    .voice-rec.is-open {
        display: flex;
    }

    .voice-rec__cancel,
    .voice-rec__send {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: none;
        width: 34px;
        height: 34px;
        padding: 0;
        border: 0;
        border-radius: 17px;
        font-size: 15px;
        cursor: pointer;
    }

    .voice-rec__cancel {
        background: #FBE4DD;
        color: #E0431F;
    }

    .voice-rec__send {
        background: #1D4ED8;
        color: #FFFFFF;
    }

    .voice-rec__dot {
        flex: none;
        width: 9px;
        height: 9px;
        background: #E0431F;
        border-radius: 50%;
        animation: voicePulse 1s ease-in-out infinite;
    }

    @@keyframes voicePulse {
        0%, 100% { opacity: 1; }
        50% { opacity: .25; }
    }

    .voice-rec__time {
        flex: none;
        min-width: 34px;
        font-size: 13px;
        line-height: 16px;
        font-variant-numeric: tabular-nums;
        color: #212529;
    }

    .voice-rec__wave {
        display: flex;
        align-items: center;
        gap: 3px;
        flex: 1 1 auto;
        height: 22px;
        overflow: hidden;
    }

    .voice-rec__wave i {
        flex: 1 1 auto;
        min-width: 2px;
        max-width: 4px;
        height: 30%;
        background: #9EB4E8;
        border-radius: 2px;
        animation: voiceBar .9s ease-in-out infinite;
    }

    .voice-rec__wave i:nth-child(3n) { animation-delay: .15s; }
    .voice-rec__wave i:nth-child(3n+1) { animation-delay: .3s; }
    .voice-rec__wave i:nth-child(4n) { animation-delay: .45s; }

    @@keyframes voiceBar {
        0%, 100% { height: 22%; }
        50% { height: 100%; }
    }

    .voice-rec__hint {
        flex: none;
        font-size: 11.5px;
        line-height: 14px;
        color: #8A93A6;
    }

    /* ------------------------------------------- voice note bubble in the stream */
    .voice-note {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 10px;
        width: 232px;
        max-width: 100%;
    }

    .voice-note__play {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: none;
        width: 28px;
        height: 28px;
        padding: 0;
        border: 0;
        background: rgba(29, 78, 216, .1);
        border-radius: 14px;
        color: #1D4ED8;
        font-size: 13px;
        cursor: pointer;
    }

    .bubble--out .voice-note__play {
        background: rgba(255, 255, 255, .22);
        color: #FFFFFF;
    }

    .voice-note__wave {
        display: flex;
        align-items: center;
        gap: 2px;
        flex: 1 1 auto;
        height: 22px;
    }

    .voice-note__wave i {
        flex: 1 1 auto;
        min-width: 2px;
        background: #9EB4E8;
        border-radius: 1px;
    }

    .bubble--out .voice-note__wave i {
        background: rgba(255, 255, 255, .6);
    }

    .voice-note__len {
        flex: none;
        font-size: 11px;
        line-height: 14px;
        font-variant-numeric: tabular-nums;
        color: #4A5468;
    }

    .bubble--out .voice-note__len {
        color: #FFFFFF;
    }

    /* ------------------------------------------------------- menus / popovers */
    .msg-menu {
        box-sizing: border-box;
        display: none;
        flex-direction: column;
        align-items: flex-start;
        padding: 6px;
        position: absolute;
        width: 180px;
        background: #FFFFFF;
        border: 1px solid #CED4DA;
        box-shadow: 0px 6px 18px rgba(0, 0, 0, 0.14);
        border-radius: 8px;
        z-index: 1050;
    }

    .msg-menu.is-open {
        display: flex;
    }

    .msg-menu__item {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 8px 10px;
        gap: 8px;
        width: 100%;
        border: 0;
        background: transparent;
        border-radius: 6px;
        font-size: 13px;
        line-height: 16px;
        color: #212529;
        text-align: left;
    }

    .msg-menu__item:hover {
        background: rgba(233, 235, 236, 0.6);
    }

    .msg-menu__item i {
        font-size: 13px;
    }

    /* Reply / Forward use the same curved arrow, mirrored — matches the UI design */
    .msg-menu__item i.icon-flip {
        transform: scaleX(-1);
    }

    .msg-menu__item--danger {
        color: #E0431F;
    }

    .msg-menu__divider {
        width: calc(100% - 8px);
        height: 1px;
        margin: 6px 4px;
        background: #E9EBEC;
    }

    .react-list {
        box-sizing: border-box;
        display: none;
        flex-direction: column;
        align-items: flex-start;
        padding: 8px;
        position: absolute;
        width: 190px;
        background: #FFFFFF;
        border: 1px solid #CED4DA;
        box-shadow: 0px 8px 22px rgba(0, 0, 0, 0.16);
        border-radius: 8px;
        z-index: 1060;
    }

    .react-list.is-open {
        display: flex;
    }

    .react-list__head {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 2px 4px 6px;
        gap: 5px;
        width: 100%;
        font-size: 11px;
        line-height: 14px;
        letter-spacing: 0.33px;
        text-transform: uppercase;
        color: #878A99;
    }

    .react-list__emoji {
        font-size: 14px;
        line-height: 16px;
    }

    .react-list__body {
        width: 100%;
        max-height: 220px;
        overflow-y: auto;
    }

    .react-list__row {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 5px 4px;
        gap: 8px;
        height: 30px;
        font-size: 12.5px;
        line-height: 16px;
        color: #212529;
    }

    /* ------------------------------------------------- quoted reply / forwarded */
    .bubble__forwarded {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 6px;
        width: 100%;
        font-size: 12px;
        line-height: 20px;
        color: #878A99;
    }

    .bubble__forwarded i {
        font-size: 12px;
    }

    .quote {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 6px 10px 6px 13px;
        gap: 1px;
        width: 100%;
        background: rgba(29, 78, 216, 0.08);
        border-left: 3px solid #1D4ED8;
        border-radius: 4px;
    }

    .quote--soft {
        background: #EDF1FC;
    }

    .quote--onblue {
        background: #FFFFFF;
    }

    .quote__head {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        width: 100%;
    }

    .quote__author {
        font-size: 12px;
        line-height: 15px;
        color: #1D4ED8;
        white-space: nowrap;
    }

    .quote__time {
        font-size: 11px;
        line-height: 14px;
        text-align: right;
        color: #878A99;
        white-space: nowrap;
    }

    .quote__text {
        padding-top: 1px;
        font-size: 13px;
        line-height: 20px;
        color: #212529;
        width: 100%;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    /* quoted file chip inside a reply */
    .quote-file {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 5px;
        border-radius: 6px;
    }

    .quote-file__thumb {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 30px;
        height: 30px;
        flex: none;
        background: linear-gradient(180deg, #E0E0F7 0%, #F0F0FA 100%);
        border-radius: 8px;
        color: #1D4ED8;
        font-size: 15px;
    }

    .quote-file__name {
        font-size: 12px;
        line-height: 15px;
        color: #212529;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* ------------------------------------------------------- reply composer bar */
    .reply-bar {
        box-sizing: border-box;
        display: none;
        flex-direction: column;
        align-items: flex-start;
        padding: 8px 16px;
        gap: 4px;
        width: 100%;
        background: #F8F6F4;
        border: 1px solid #1D4ED8;
        border-left-width: 3px;
        border-radius: 4px;
    }

    .reply-bar.is-open {
        display: flex;
    }

    .reply-bar__head {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        width: 100%;
    }

    .reply-bar__label {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        line-height: 15px;
        color: #1D4ED8;
    }

    .reply-bar__close {
        border: 0;
        background: transparent;
        padding: 0;
        color: #878A99;
        font-size: 14px;
        line-height: 1;
    }

    .reply-bar__text {
        font-size: 13px;
        line-height: 16px;
        color: #495057;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* composer becomes a column when the reply bar / tray is visible */
    .chat-composer {
        flex-wrap: wrap;
    }

    .composer-main {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        width: 100%;
    }

    .chat-composer--stacked {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
        height: auto;
    }

    /* --------------------------------------------------------- attachments (msg) */
    .attach-image {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        max-width: 300px;
        height: 170px;
        background: linear-gradient(135deg, #E0E0F7 0%, #F0F0FA 100%);
        border-radius: 6px;
        color: #1D4ED8;
        font-size: 34px;
    }

    .attach-dl {
        position: absolute;
        display: flex;
        justify-content: center;
        align-items: center;
        top: 8px;
        right: 8px;
        width: 24px;
        height: 24px;
        border: 0;
        background: rgba(1, 1, 1, 0.5);
        border-radius: 14px;
        color: #FFFFFF;
        font-size: 13px;
    }

    .attach-file {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 10px 13px;
        gap: 10px;
        width: 100%;
        max-width: 300px;
        border: 1px solid #E9EBEC;
        border-radius: 6px;
    }

    .attach-file--onblue {
        background: #FFFFFF;
    }

    .attach-file__thumb {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 36px;
        height: 36px;
        flex: none;
        background: linear-gradient(135deg, #E0E0F7 0%, #F0F0FA 100%);
        border-radius: 6px;
        color: #1D4ED8;
        font-size: 18px;
    }

    .attach-file__body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        flex: 1 1 auto;
        min-width: 0;
    }

    .attach-file__name {
        font-size: 13.5px;
        line-height: 17px;
        color: #212529;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .attach-file__meta {
        font-size: 11.5px;
        line-height: 14px;
        color: #878A99;
    }

    .attach-file__dl {
        border: 0;
        background: transparent;
        padding: 0;
        flex: none;
        color: #495057;
        font-size: 16px;
        line-height: 1;
    }

    /* image grid (2x2 + overflow) */
    .attach-grid {
        position: relative;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px;
        width: 100%;
        max-width: 400px;
        border-radius: 6px;
        overflow: hidden;
    }

    .attach-grid__cell {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100px;
        background: linear-gradient(121.33deg, #E0E0F7 0%, #F0F0FA 100%);
        color: #1D4ED8;
        font-size: 22px;
    }

    .attach-grid__more {
        position: absolute;
        inset: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        background: rgba(33, 37, 41, 0.55);
        font-size: 18px;
        line-height: 20px;
        color: #FFFFFF;
    }

    .attach-dl-all {
        position: absolute;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 3px;
        padding: 5px 7px;
        top: 5px;
        right: 5px;
        height: 23px;
        border: 0;
        background: rgba(0, 0, 0, 0.5);
        border-radius: 5px;
        font-size: 11px;
        line-height: 14px;
        color: #FFFFFF;
        z-index: 2;
    }

    .attach-note {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 4px;
        font-size: 10.5px;
        line-height: 13px;
        color: #878A99;
    }

    /* ------------------------------------------------------ composer attach tray */
    .attach-tray {
        display: none;
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
    }

    .attach-tray.is-open {
        display: flex;
    }

    .attach-tray__row {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        padding: 8px 24px;
        gap: 8px;
        width: 100%;
        overflow-x: auto;
        background: rgba(33, 37, 41, 0.1);
    }

    .attach-card {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 8px 10px;
        gap: 10px;
        width: 250px;
        max-width: 250px;
        flex: none;
        background: #FFFFFF;
        border-radius: 4px;
    }

    .attach-card__name {
        font-size: 13px;
        line-height: 16px;
        color: #212529;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .attach-card__size {
        font-size: 11.5px;
        line-height: 14px;
        color: #878A99;
    }

    .attach-card__x {
        border: 0;
        background: transparent;
        padding: 0;
        flex: none;
        color: #878A99;
        font-size: 16px;
        line-height: 1;
    }

    .attach-progress {
        width: 100%;
        height: 4px;
        background: #EEF0F4;
        border-radius: 2px;
    }

    .attach-progress__bar {
        width: 55%;
        height: 100%;
        background: #D3DAE6;
        border-radius: 2px;
    }

    .attach-tray__note {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px 14px;
        width: 100%;
        font-size: 10.5px;
        line-height: 13px;
        color: #878A99;
    }

    /* -------------------------------------------------------- members side panel */
    .msg-chat {
        position: relative;
        overflow: hidden;
    }

    .members-panel {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        position: absolute;
        width: 300px;
        top: 69px;
        bottom: 0;
        right: 0;
        background: #FFFFFF;
        /* shadow only once the panel slides in — otherwise it bleeds into the
           visible chat stream even while the panel is parked off-screen */
        box-shadow: none;
        transform: translateX(100%);
        transition: transform .18s ease-in-out, box-shadow .18s ease-in-out;
        z-index: 20;
    }

    .members-panel.is-open {
        transform: translateX(0);
        box-shadow: -6px 0px 18px rgba(0, 0, 0, 0.1);
    }

    .members-panel__head {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 14px 16px 10px;
        gap: 10px;
        width: 100%;
    }

    .members-panel__head > button {
        border: 0;
        background: transparent;
        padding: 0;
        flex: none;
        line-height: 1;
        color: #212529;
        font-size: 16px;
    }

    .members-panel__title {
        flex: 1 1 auto;
        font-size: 15px;
        line-height: 19px;
        color: #212529;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .members-panel__count {
        display: flex;
        align-items: center;
        padding: 1px 8px;
        height: 17px;
        flex: none;
        background: #E9EBEC;
        border-radius: 10px;
        font-size: 12px;
        line-height: 15px;
        color: #878A99;
    }

    .members-panel__search {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 10px 16px 0;
        width: 100%;
    }

    .members-panel__search label {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 0 13px;
        gap: 10px;
        width: 100%;
        height: 32px;
        border: 1px solid #CED4DA;
        border-radius: 4px;
    }

    .members-panel__search i {
        font-size: 13px;
        color: #878A99;
    }

    .members-panel__search input {
        border: 0;
        outline: 0;
        background: transparent;
        width: 100%;
        font-size: 14px;
        line-height: 18px;
        color: #212529;
    }

    .members-panel__search input::placeholder {
        color: #878A99;
    }

    .members-row {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 8px 10px;
        gap: 10px;
        width: 100%;
        border: 0;
        background: transparent;
        border-radius: 6px;
        font-size: 15px;
        line-height: 19px;
        color: #212529;
        text-align: left;
    }

    .members-row:hover {
        background: rgba(233, 235, 236, 0.6);
    }

    .members-row i {
        font-size: 15px;
        color: #495057;
    }

    .members-panel__addwrap {
        display: flex;
        flex-direction: column;
        padding: 8px 10px 0;
        width: 100%;
    }

    .members-panel__label {
        display: flex;
        align-items: center;
        padding: 6px 10px 2px;
        width: 100%;
        font-size: 11px;
        line-height: 12px;
        letter-spacing: 0.33px;
        text-transform: uppercase;
        color: #878A99;
    }

    .members-panel__list {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 0 10px;
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
    }

    .member-item {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 8px 6px;
        gap: 10px;
        width: 100%;
        flex: none;
        border-radius: 6px;
    }

    .member-item:hover {
        background: rgba(233, 235, 236, 0.6);
    }

    .avatar--md {
        width: 28px;
        height: 28px;
        border-radius: 14px;
        font-size: 10.5px;
        line-height: 12px;
    }

    .member-item__name {
        display: flex;
        align-items: flex-end;
        gap: 4px;
        flex: 1 1 auto;
        min-width: 0;
        font-size: 13.5px;
        line-height: 17px;
        color: #212529;
    }

    .member-item__role {
        font-size: 12px;
        line-height: 15px;
        color: #878A99;
    }

    .member-item__kebab {
        border: 0;
        background: transparent;
        padding: 0;
        flex: none;
        width: 15px;
        color: #878A99;
        font-size: 14px;
        line-height: 1;
    }

    .members-panel__foot {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 6px 10px 10px;
        width: 100%;
        border-top: 1px solid #E9EBEC;
    }

    .members-row--danger {
        color: #E0431F;
    }

    .members-row--danger i {
        color: #E0431F;
    }

    /* ------------------------------------------------------- add people modal */
    .people-modal {
        box-sizing: border-box;
        display: none;
        flex-direction: column;
        width: 340px;
        position: fixed;
        background: #FFFFFF;
        box-shadow: 0px 12px 28px rgba(22, 27, 34, 0.16);
        border-radius: 12px;
        overflow: hidden;
        z-index: 1070;
    }

    .people-modal.is-open {
        display: flex;
    }

    .people-modal__tabs {
        display: flex;
        flex-direction: row;
        width: 100%;
        height: 40px;
        background: #FAFBFC;
    }

    .people-tab {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        flex: 1 1 0;
        height: 39px;
        border: 0;
        background: transparent;
        font-size: 13px;
        line-height: 16px;
        color: #8A93A6;
    }

    .people-tab.is-active {
        background: #FFFFFF;
        color: #1D4ED8;
    }

    .people-tab__badge {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 17.84px;
        height: 14px;
        background: #E9EBEC;
        border-radius: 8px;
        font-size: 10.5px;
        line-height: 13px;
        color: #4A5468;
    }

    .people-tab.is-active .people-tab__badge {
        background: #1D4ED8;
        color: #FFFFFF;
    }

    .people-modal__search {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 8px;
        padding: 0 12px;
        width: 100%;
        height: 38px;
    }

    .people-modal__search i {
        font-size: 14px;
        color: #8A93A6;
    }

    .people-modal__search input {
        border: 0;
        outline: 0;
        background: transparent;
        width: 100%;
        font-size: 13px;
        line-height: 16px;
        color: #212529;
    }

    .people-modal__search input::placeholder {
        color: #757575;
    }

    .people-modal__all {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 8px;
        padding: 0 12px;
        width: 100%;
        height: 36px;
        background: #FFFFFF;
        font-size: 12.5px;
        line-height: 16px;
        color: #4A5468;
    }

    .people-check {
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 17px;
        height: 17px;
        flex: none;
        margin: 0;
        appearance: none;
        -webkit-appearance: none;
        background: #FFFFFF;
        border: 1px solid #D3DAE6;
        border-radius: 4px;
        cursor: pointer;
    }

    .people-check:checked {
        background: #1D4ED8;
        border-color: #1D4ED8;
    }

    .people-check:checked::after {
        content: "\F26E";
        font-family: "bootstrap-icons";
        font-size: 11px;
        color: #FFFFFF;
        line-height: 1;
    }

    .people-modal__list {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
        max-height: 183px;
        overflow-y: auto;
    }

    .people-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 12px;
        padding: 0 12px;
        width: 100%;
        height: 46px;
        flex: none;
    }

    .people-row:hover {
        background: rgba(233, 235, 236, 0.5);
    }

    .avatar--26 {
        width: 26px;
        height: 26px;
        border-radius: 13px;
        font-size: 10px;
        line-height: 11px;
    }

    .people-row__body {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-width: 0;
    }

    .people-row__name {
        font-size: 13.5px;
        line-height: 17px;
        color: #161B22;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .people-row__sub {
        font-size: 11.5px;
        line-height: 14px;
        color: #878A99;
    }

    .people-modal__foot {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 0 12px;
        width: 100%;
        height: 49px;
        background: #FAFBFC;
        border-top: 1px solid #F0F1F5;
    }

    .people-modal__count {
        font-size: 12px;
        line-height: 15px;
        color: #8A93A6;
    }

    .people-modal__add {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0 12px;
        height: 28px;
        border: 0;
        background: #1D4ED8;
        border-radius: 8px;
        font-size: 12.5px;
        line-height: 16px;
        color: #FFFFFF;
    }

    /* ------------------------------------------------- files / settings panels */
    .side-tabs {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        padding: 10px 16px 0;
        gap: 14px;
        width: 100%;
        border-bottom: 1px solid #E9EBEC;
    }

    .side-tab {
        border: 0;
        background: transparent;
        padding: 0 0 8px;
        font-size: 12.5px;
        line-height: 16px;
        color: #878A99;
        border-bottom: 2px solid transparent;
    }

    .side-tab.is-active {
        color: #1D4ED8;
        border-bottom-color: #1D4ED8;
    }

    .file-list {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 8px 10px;
        width: 100%;
        flex: 1 1 auto;
        overflow-y: auto;
    }

    .file-list__label {
        width: 100%;
        padding: 10px 6px 4px;
        font-size: 10.5px;
        line-height: 13px;
        letter-spacing: 0.525px;
        text-transform: uppercase;
        color: #878A99;
    }

    .file-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 8px 6px;
        gap: 10px;
        width: 100%;
        border: 0;
        background: transparent;
        border-radius: 6px;
        text-align: left;
    }

    .file-row:hover {
        background: #F5F6FA;
    }

    .file-row__icon {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: none;
        width: 30px;
        height: 30px;
        background: #EAF3FF;
        border-radius: 8px;
        color: #1D4ED8;
        font-size: 15px;
    }

    .file-row__body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
        flex: 1 1 auto;
        min-width: 0;
    }

    .file-row__name {
        width: 100%;
        font-size: 12.5px;
        line-height: 16px;
        color: #212529;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .file-row__meta {
        font-size: 11px;
        line-height: 14px;
        color: #878A99;
    }

    .file-row__dl {
        flex: none;
        color: #878A99;
        font-size: 15px;
    }

    .settings-list {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 6px 10px 8px;
        width: 100%;
        flex: 1 1 auto;
        overflow-y: auto;
    }

    .settings-row {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        padding: 8px 10px;
        gap: 10px;
        width: 100%;
        border: 0;
        background: transparent;
        border-radius: 6px;
        text-align: left;
    }

    .settings-row:hover {
        background: #F5F6FA;
    }

    .settings-row > i {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: none;
        width: 16px;
        height: 19px;
        font-size: 15px;
        line-height: 19px;
        color: #495057;
    }

    /* rows with a title but no sub-label centre the icon against the single line */
    .settings-row--single {
        align-items: center;
    }

    /* bootstrap-icons nudge their glyph down with vertical-align; undo it so the
       icon sits dead-centre against the row text */
    .settings-row > i::before,
    .icon-chip i::before {
        vertical-align: 0;
        line-height: 1;
    }

    .settings-row__title {
        font-size: 15px;
        line-height: 19px;
        color: #212529;
    }

    .settings-row__sub {
        font-size: 11.5px;
        line-height: 16px;
        color: #878A99;
    }

    .settings-row--danger > i,
    .settings-row--danger .settings-row__title {
        color: #E0431F;
    }

    .settings-divider {
        width: 275px;
        height: 1px;
        flex: none;
        margin: 6px 0;
        background: #E9EBEC;
    }

    /* ---------------------------------------------------------- modal shell */
    .zx-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(24, 24, 40, .2);
        z-index: 1050;
    }

    .zx-backdrop.is-open {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .zx-modal {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 24px;
        gap: 4px;
        width: 460px;
        max-width: calc(100vw - 24px);
        max-height: calc(100vh - 40px);
        overflow-y: auto;
        background: #FFFFFF;
        box-shadow: 0 20px 50px rgba(0, 0, 0, .25);
        border-radius: 8px;
    }

    .zx-modal__title {
        width: 100%;
        padding-bottom: 1px;
        font-size: 20px;
        line-height: 25px;
        color: #212529;
    }

    .zx-modal__sub {
        width: 100%;
        font-size: 14px;
        line-height: 20px;
        color: #878A99;
    }

    .zx-modal__label {
        display: flex;
        align-items: flex-start;
        gap: 4px;
        padding: 8px 0 4px;
        width: 100%;
        font-size: 14px;
        line-height: 18px;
        color: #212529;
    }

    .zx-modal__label span {
        color: #E0431F;
    }

    .zx-modal__foot {
        display: flex;
        flex-direction: row;
        justify-content: flex-end;
        align-items: flex-start;
        padding: 16px 0 0;
        gap: 10px;
        width: 100%;
    }

    .zx-btn {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 18px;
        height: 38px;
        background: #FFFFFF;
        border: 1px solid #CED4DA;
        border-radius: 4px;
        font-size: 14px;
        line-height: 18px;
        color: #212529;
    }

    .zx-btn--primary {
        background: #1D4ED8;
        border-color: #1D4ED8;
        color: #FFFFFF;
    }

    .zx-btn--danger {
        background: #E0431F;
        border-color: #E0431F;
        color: #FFFFFF;
    }

    .zx-btn--primary:disabled,
    .zx-btn--danger:disabled {
        background: rgba(29, 78, 216, .15);
        border-color: transparent;
        color: #FFFFFF;
    }

    /* ------------------------------------------------- forward message modal */
    .fwd-chips {
        box-sizing: border-box;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        padding: 4px 12px;
        gap: 8px;
        width: 100%;
        min-height: 38px;
        border: 1px solid #CED4DA;
        border-radius: 4px;
        color: #878A99;
    }

    .fwd-chip {
        display: flex;
        align-items: center;
        padding: 5px 10px 5px 6px;
        gap: 6px;
        height: 28px;
        background: #ECECFB;
        border-radius: 16px;
        font-size: 13px;
        line-height: 16px;
        color: #1D4ED8;
    }

    .fwd-chip__dot {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 18px;
        height: 18px;
        flex: none;
        background: rgba(29, 78, 216, .2);
        border-radius: 9px;
        font-size: 8px;
        line-height: 1;
        font-weight: 600;
        font-style: normal;
        color: #212529;
    }

    .fwd-chip__x {
        border: 0;
        background: transparent;
        padding: 0;
        line-height: 1;
        color: #1D4ED8;
        font-size: 12px;
    }

    .fwd-chips input {
        border: 0;
        outline: 0;
        flex: 1 1 90px;
        min-width: 90px;
        font-size: 14px;
        line-height: 18px;
        color: #212529;
        background: transparent;
    }

    /* expandable "add a message" field — grows with the typed text */
    .fwd-note {
        box-sizing: border-box;
        display: block;
        width: 100%;
        min-height: 32px;
        max-height: 120px;
        padding: 7px 14px;
        border: 1px solid #CED4DA;
        border-radius: 4px;
        font-family: inherit;
        font-size: 14px;
        line-height: 18px;
        color: #212529;
        outline: 0;
        resize: none;
        overflow-y: auto;
    }

    .fwd-note:focus {
        border-color: #1D4ED8;
    }

    .fwd-preview {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 11px 13px;
        gap: 5px;
        width: 100%;
        border: 1px solid #CED4DA;
        border-radius: 4px;
    }

    /* grows with the content, but caps + scrolls so a long forwarded message
       can't blow up the modal */
    .fwd-preview__scroll {
        width: 100%;
        max-height: 108px;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .fwd-preview__head {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 6px;
        width: 100%;
        font-size: 13px;
        line-height: 16px;
        color: #495057;
    }

    .fwd-preview__head time {
        color: #878A99;
    }

    .fwd-preview__body {
        width: 100%;
        padding-bottom: 19.5px;
        font-size: 13px;
        line-height: 20px;
        color: #212529;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    /* attachment shown inside the forward preview */
    .fwd-preview__attach {
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: 100%;
    }

    .fwd-attach {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: 9px;
        width: 100%;
        padding: 7px 9px;
        background: #F5F6FA;
        border: 1px solid #E7EAF0;
        border-radius: 6px;
    }

    .fwd-attach__thumb {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: none;
        width: 30px;
        height: 30px;
        background: #EAF3FF;
        border-radius: 6px;
        color: #1D4ED8;
        font-size: 15px;
    }

    .fwd-attach__body {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1 1 auto;
    }

    .fwd-attach__name {
        font-size: 12.5px;
        line-height: 16px;
        color: #212529;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .fwd-attach__meta {
        font-size: 11px;
        line-height: 14px;
        color: #878A99;
    }

    .fwd-attach__img {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: none;
        width: 100%;
        height: 84px;
        background: linear-gradient(121.33deg, #E0E0F7 0%, #F0F0FA 100%);
        border-radius: 6px;
        color: #1D4ED8;
        font-size: 22px;
    }

    /* recipient suggestion dropdown for the forward search bar */
    .fwd-sugg {
        display: none;
        box-sizing: border-box;
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        width: 100%;
        max-height: 190px;
        overflow-y: auto;
        padding: 5px;
        background: #FFFFFF;
        border: 1px solid #D3DAE6;
        box-shadow: 0 10px 26px rgba(22, 27, 34, .14);
        border-radius: 8px;
        z-index: 20;
    }

    .fwd-sugg.is-open {
        display: block;
    }

    .fwd-sugg__label {
        padding: 5px 8px 3px;
        font-size: 10.5px;
        line-height: 13px;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #8A93A6;
    }

    .fwd-sugg__row {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 6px 8px;
        border: 0;
        background: transparent;
        border-radius: 6px;
        font-size: 13px;
        line-height: 16px;
        color: #212529;
        text-align: left;
    }

    .fwd-sugg__row:hover,
    .fwd-sugg__row.is-cursor {
        background: #F0F4FF;
    }

    .fwd-sugg__sub {
        margin-left: auto;
        font-size: 11px;
        color: #8A93A6;
    }

    .fwd-sugg__empty {
        padding: 8px;
        font-size: 12.5px;
        color: #8A93A6;
    }

    /* -------------------------------------------------------- rename modal */
    .rn-input {
        box-sizing: border-box;
        width: 100%;
        height: 36px;
        padding: 0 12px;
        border: 1px solid #CED4DA;
        border-radius: 4px;
        font-size: 14px;
        color: #212529;
        outline: 0;
    }

    .rn-input.is-invalid {
        border-color: #E0431F;
    }

    .rn-hintrow {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding-top: 2px;
        width: 100%;
    }

    .rn-error {
        display: none;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        line-height: 15px;
        color: #E0431F;
    }

    .rn-error.is-shown {
        display: flex;
    }

    .rn-counter {
        font-size: 11px;
        line-height: 14px;
        color: #878A99;
    }

    /* --------------------------------------------------- delete group modal */
    .del-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        align-self: flex-start;
        flex: none;
        width: 44px;
        height: 44px;
        background: #FBE4DD;
        border-radius: 22px;
        color: #E0431F;
        font-size: 22px;
        line-height: 1;
    }

    .del-icon i {
        display: block;
        line-height: 0;
    }

    .del-stats {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        padding: 10px 12px;
        gap: 18px;
        width: 100%;
        background: #E9EBEC;
        border-radius: 6px;
        font-size: 12.5px;
        line-height: 16px;
        color: #212529;
    }

    .del-confirm {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding: 11px 4px;
        width: 100%;
        font-size: 13px;
        line-height: 16px;
        color: #495057;
    }

    .del-confirm input {
        flex: none;
        margin-top: 2px;
        width: 13px;
        height: 13px;
        accent-color: #E0431F;
    }

    /* --------------------------------------------------------- image viewer */
    .img-view {
        display: none;
        position: fixed;
        inset: 0;
        flex-direction: column;
        background: #F5F6FD;
        z-index: 1060;
    }

    .img-view.is-open {
        display: flex;
    }

    .img-view__bar {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 14px 40px;
        height: 65px;
        flex: none;
        background: #F9F9F9;
    }

    .img-view__name {
        font-size: 14px;
        line-height: 18px;
        color: #212529;
    }

    .img-view__sub {
        font-size: 12px;
        line-height: 15px;
        color: #212529;
    }

    .img-view__tools {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 8px;
    }

    .img-view__btn {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        height: 32px;
        border: 0;
        background: #EAF3FF;
        border-radius: 6px;
        font-size: 13px;
        line-height: 16px;
        color: #1D4ED8;
    }

    .img-view__btn--plain {
        background: transparent;
    }

    .img-view__stage {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 40px;
        padding: 40px 77px;
        flex: 1 1 auto;
        min-height: 0;
    }

    .img-view__nav {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: none;
        width: 43px;
        height: 43px;
        border: 0;
        background: #E9EBEC;
        border-radius: 22px;
        color: #212529;
        font-size: 16px;
    }

    .img-view__photo {
        flex: 1 1 auto;
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(135deg, #E0E0F7 0%, #CFE0FB 55%, #F0F0FA 100%);
    }

    .img-view__foot {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding-bottom: 22px;
        flex: none;
    }

    .img-view__zoom {
        display: flex;
        gap: 14px;
    }

    .img-view__zoom button {
        border: 0;
        background: transparent;
        padding: 0;
        color: #212529;
        font-size: 20px;
        line-height: 1;
    }

    .img-view__index {
        font-size: 12px;
        line-height: 15px;
        color: #212529;
    }

    /* --------------------------------------------------------- compose modal */
    .cmp-modal {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 20px 30px;
        gap: 17px;
        width: 860px;
        max-width: calc(100vw - 24px);
        max-height: calc(100vh - 40px);
        overflow-y: auto;
        background: #FFFFFF;
        box-shadow: 0 1px 1.5px rgba(22, 27, 34, .05), 0 24px 48px rgba(22, 27, 34, .14);
