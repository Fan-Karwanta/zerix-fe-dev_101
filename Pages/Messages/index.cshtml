            peopleAll.addEventListener('change', () => {
                activeList().querySelectorAll('.people-check')
                    .forEach(b => b.checked = peopleAll.checked);
                refreshPeopleCount();
            });

            peopleModal.addEventListener('change', (e) => {
                if (e.target.classList.contains('people-check') && e.target !== peopleAll) {
                    refreshPeopleCount();
                }
            });

            peopleSearch.addEventListener('input', () => {
                const term = peopleSearch.value.trim().toLowerCase();
                activeList().querySelectorAll('.people-row').forEach(row => {
                    row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
                });
            });

            document.getElementById('peopleAdd').addEventListener('click', () => {
                peopleModal.classList.remove('is-open');
            });

            peopleModal.addEventListener('click', (e) => e.stopPropagation());
            document.addEventListener('click', (e) => {
                if (!e.target.closest('#peopleModal') && !e.target.closest('#addPeopleBtn')) {
                    peopleModal.classList.remove('is-open');
                }
            });
            refreshPeopleCount();
        }

        // ----------------------------------------------------- reply composer bar
        const replyBar = document.getElementById('replyBar');
        const replyName = document.getElementById('replyName');
        const replyText = document.getElementById('replyText');
        const chatComposer = document.getElementById('chatComposer');

        const syncComposerLayout = () => {
            const stacked = replyBar.classList.contains('is-open');
            chatComposer.classList.toggle('chat-composer--stacked', stacked);
        };

        const openReply = (row) => {
            const author = row.querySelector('.msg-author');
            const text = row.querySelector('.bubble__text');
            replyName.textContent = author ? author.textContent.trim() : 'You';
            replyText.textContent = text ? text.textContent.trim() : '';
            replyBar.classList.add('is-open');
            syncComposerLayout();
            composer && composer.focus();
        };

        document.getElementById('replyClose').addEventListener('click', () => {
            replyBar.classList.remove('is-open');
            syncComposerLayout();
        });

        // "Reply" in either message menu quotes the message it was opened from
        let menuSourceRow = null;
        document.addEventListener('click', (e) => {
            const trigger = e.target.closest('[data-menu]');
            if (trigger) menuSourceRow = trigger.closest('.msg-row');
        }, true);

        ['theirMessageMenu', 'myMessageMenu'].forEach(id => {
            const menu = document.getElementById(id);
            menu && menu.addEventListener('click', (e) => {
                const item = e.target.closest('.msg-menu__item');
                if (!item) return;
                if (item.textContent.trim().startsWith('Reply') && menuSourceRow) {
                    openReply(menuSourceRow);
                }
                menu.classList.remove('is-open');
            });
        });

        // ------------------------------------------------------- attachment tray
        const attachTray = document.getElementById('attachTray');
        const attachToggle = document.getElementById('attachToggle');
        const attachCount = document.getElementById('attachCount');

        const refreshAttachCount = () => {
            const n = attachTray.querySelectorAll('.attach-card').length;
            attachCount.textContent = n + (n === 1 ? ' file attached' : ' files attached');
            if (!n) attachTray.classList.remove('is-open');
        };

        attachToggle && attachToggle.addEventListener('click', () => {
            if (!attachTray.querySelectorAll('.attach-card').length) return;
            attachTray.classList.toggle('is-open');
        });

        attachTray && attachTray.addEventListener('click', (e) => {
            const x = e.target.closest('.attach-card__x');
            if (!x) return;
            x.closest('.attach-card').remove();
            refreshAttachCount();
        });

        // Clear the reply bar after a message is sent
        const clearReply = () => {
            replyBar.classList.remove('is-open');
            syncComposerLayout();
        };
        sendBtn && sendBtn.addEventListener('click', clearReply);
        composer && composer.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) clearReply();
        });

        // ------------------------------------------- side panels (files/settings)
        const sidePanels = ['membersPanel', 'filesPanel', 'settingsPanel']
            .map(id => document.getElementById(id)).filter(Boolean);

        const openSidePanel = (panel) => {
            const wasOpen = panel.classList.contains('is-open');
            sidePanels.forEach(p => p.classList.remove('is-open'));
            panel.classList.toggle('is-open', !wasOpen);
        };

        // re-wire the People button so the three panels are mutually exclusive
        if (peopleToggle && membersPanel) {
            const fresh = peopleToggle.cloneNode(true);
            peopleToggle.replaceWith(fresh);
            fresh.addEventListener('click', () => openSidePanel(membersPanel));
        }

        [['filesToggle', 'filesPanel'], ['settingsToggle', 'settingsPanel']].forEach(([btnId, panelId]) => {
            const btn = document.getElementById(btnId);
            const panel = document.getElementById(panelId);
            btn && panel && btn.addEventListener('click', () => openSidePanel(panel));
        });

        document.querySelectorAll('[data-side-close]').forEach(btn => {
            btn.addEventListener('click', () => btn.closest('.members-panel').classList.remove('is-open'));
        });

        // -------------------------------------------------- search in conversation
        const searchWrap = document.getElementById('chatSearchWrap');
        const searchInput = document.getElementById('chatSearchInput');
        const searchCount = document.getElementById('chatSearchCount');
        const searchPrev = document.getElementById('chatSearchPrev');
        const searchNext = document.getElementById('chatSearchNext');
        const searchClear = document.getElementById('chatSearchClear');
        let streamEmpty = stream ? stream.querySelector('.stream-empty') : null;

        let hits = [];
        let hitIndex = -1;

        // text nodes we are allowed to highlight (message bodies and quoted text)
        const SEARCHABLE = '.bubble__text, .quote__text, .attach-file__name, .quote-file__name';

        const unmark = (root) => {
            root.querySelectorAll('mark.msg-hit').forEach(m => {
                const parent = m.parentNode;
                parent.replaceChild(document.createTextNode(m.textContent), m);
                parent.normalize();
            });
        };

        const markIn = (el, term) => {
            let found = 0;
            const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
                acceptNode: (node) => node.nodeValue.toLowerCase().includes(term)
                    ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT
            });
            const targets = [];
            while (walker.nextNode()) targets.push(walker.currentNode);

            targets.forEach(node => {
                const text = node.nodeValue;
                const lower = text.toLowerCase();
                const frag = document.createDocumentFragment();
                let at = 0;
                let i = lower.indexOf(term);
                while (i !== -1) {
                    if (i > at) frag.appendChild(document.createTextNode(text.slice(at, i)));
                    const mark = document.createElement('mark');
                    mark.className = 'msg-hit';
                    mark.textContent = text.slice(i, i + term.length);
                    frag.appendChild(mark);
                    found++;
                    at = i + term.length;
                    i = lower.indexOf(term, at);
                }
                if (at < text.length) frag.appendChild(document.createTextNode(text.slice(at)));
                node.parentNode.replaceChild(frag, node);
            });
            return found;
        };

        const setCurrentHit = (index) => {
            if (!hits.length) return;
            hitIndex = (index + hits.length) % hits.length;
            hits.forEach(h => h.classList.remove('is-current'));
            const current = hits[hitIndex];
            current.classList.add('is-current');
            current.scrollIntoView({ block: 'center', behavior: 'smooth' });
            searchCount.textContent = (hitIndex + 1) + '/' + hits.length;
        };

        const runConversationSearch = () => {
            if (!stream || !searchInput) return;
            const term = searchInput.value.trim().toLowerCase();

            unmark(stream);
            hits = [];
            hitIndex = -1;

            const rows = [...stream.querySelectorAll('.msg-row')];
            const chrome = [...stream.querySelectorAll('.stream-note, .stream-divider')];

            if (!term) {
                searchWrap.classList.remove('is-active');
                searchCount.textContent = '';
                rows.forEach(r => r.classList.remove('is-filtered'));
                chrome.forEach(c => c.classList.remove('is-filtered'));
                streamEmpty && streamEmpty.classList.remove('is-shown');
                searchPrev.disabled = searchNext.disabled = true;
                return;
            }

            searchWrap.classList.add('is-active');
            // date separators / system notes are noise while searching
            chrome.forEach(c => c.classList.add('is-filtered'));

            let matchedRows = 0;
            rows.forEach(row => {
                let rowHits = 0;
                row.querySelectorAll(SEARCHABLE).forEach(el => { rowHits += markIn(el, term); });
                const matched = rowHits > 0;
                row.classList.toggle('is-filtered', !matched);
                if (matched) matchedRows++;
            });

            hits = [...stream.querySelectorAll('mark.msg-hit')];
            streamEmpty && streamEmpty.classList.toggle('is-shown', matchedRows === 0);
            searchPrev.disabled = searchNext.disabled = hits.length === 0;

            if (!hits.length) {
                searchCount.textContent = '0 results';
                return;
            }
            setCurrentHit(0);
        };

        const resetConversationSearch = () => {
            if (!searchInput) return;
            searchInput.value = '';
            runConversationSearch();
        };

        if (searchInput) {
            let debounce;
            searchInput.addEventListener('input', () => {
                clearTimeout(debounce);
                debounce = setTimeout(runConversationSearch, 140);
            });
            searchInput.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') { resetConversationSearch(); searchInput.blur(); return; }
                if (e.key === 'Enter') {
                    e.preventDefault();
                    if (hits.length) setCurrentHit(hitIndex + (e.shiftKey ? -1 : 1));
                }
            });
            searchNext.addEventListener('click', (e) => { e.preventDefault(); setCurrentHit(hitIndex + 1); });
            searchPrev.addEventListener('click', (e) => { e.preventDefault(); setCurrentHit(hitIndex - 1); });
            searchClear.addEventListener('click', (e) => { e.preventDefault(); resetConversationSearch(); searchInput.focus(); });
            searchPrev.disabled = searchNext.disabled = true;
        }

        // "Search in Conversation" in the Settings panel focuses the header search
        const settingsSearchRow = document.getElementById('settingsSearchRow');
        settingsSearchRow && settingsSearchRow.addEventListener('click', () => {
            const panel = document.getElementById('settingsPanel');
            panel && panel.classList.remove('is-open');
            searchInput && searchInput.focus();
        });

        // Files panel: tabs + search
        const fileList = document.getElementById('fileList');
        const fileSearch = document.getElementById('fileSearch');

        const filterFiles = () => {
            const tab = document.querySelector('[data-file-tab].is-active');
            const kind = tab ? tab.dataset.fileTab : 'all';
            const term = fileSearch ? fileSearch.value.trim().toLowerCase() : '';
            fileList.querySelectorAll('.file-row').forEach(row => {
                const okKind = kind === 'all' || row.dataset.kind === kind;
                const okTerm = !term || row.textContent.toLowerCase().includes(term);
                row.style.display = okKind && okTerm ? '' : 'none';
            });
            fileList.querySelectorAll('.file-list__label').forEach(label => {
                label.style.display = kind === 'all' && !term ? '' : 'none';
            });
        };

        document.querySelectorAll('[data-file-tab]').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('[data-file-tab]').forEach(t => t.classList.remove('is-active'));
                tab.classList.add('is-active');
                filterFiles();
            });
        });
        fileSearch && fileSearch.addEventListener('input', filterFiles);

        // ------------------------------------------------------------ modal shell
        const openModal = (id) => {
            const modal = document.getElementById(id);
            if (!modal) return null;
            modal.classList.add('is-open');
            document.body.style.overflow = 'hidden';
            return modal;
        };
        const closeModal = (modal) => {
            modal.classList.remove('is-open');
            document.body.style.overflow = '';
        };

        document.querySelectorAll('.zx-backdrop').forEach(backdrop => {
            backdrop.addEventListener('click', (e) => {
                if (e.target === backdrop || e.target.closest('[data-zx-close]')) closeModal(backdrop);
            });
        });
        document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape') return;
            document.querySelectorAll('.zx-backdrop.is-open').forEach(closeModal);
            const viewer = document.getElementById('imageViewer');
            if (viewer && viewer.classList.contains('is-open')) {
                viewer.classList.remove('is-open');
                document.body.style.overflow = '';
            }
        });

        // ----------------------------------------------- forward message modal
        const fwdChips = document.getElementById('fwdChips');
        const fwdSubmit = document.getElementById('fwdSubmit');
        const fwdPreviewText = document.getElementById('fwdPreviewText');
        const fwdPreviewFile = document.getElementById('fwdPreviewFile');
        const fwdPreviewAttach = document.getElementById('fwdPreviewAttach');
        const fwdAttachFile = document.getElementById('fwdAttachFile');
        const fwdAttachImage = document.getElementById('fwdAttachImage');
        const fwdAttachName = document.getElementById('fwdAttachName');
        const fwdAttachMeta = document.getElementById('fwdAttachMeta');
        const fwdSearch = document.getElementById('fwdSearch');
        const fwdSugg = document.getElementById('fwdSugg');
        const fwdNote = document.getElementById('fwdNote');

        // chats / channels available as forward targets
        const FWD_TARGETS = [
            { name: 'HR Team', sub: '12 members', tint: '#B7C9F2' },
            { name: 'Design Team', sub: '8 members', tint: '#FFD59E' },
            { name: 'Marketing', sub: '15 members', tint: '#A8DAB5' },
            { name: 'Project Alpha', sub: '6 members', tint: '#F2B7D6' },
            { name: 'Maria Reyes', sub: 'Direct message', tint: '#FFD59E' },
            { name: 'Clint Barton', sub: 'Direct message', tint: '#FFB199' },
            { name: 'Natasha Romanoff', sub: 'Direct message', tint: '#B8E0D2' },
            { name: 'Bruce Banner', sub: 'Direct message', tint: '#B7C9F2' },
            { name: 'Ana Cruz', sub: 'Direct message', tint: '#D9CBF2' },
            { name: 'Steve Rogers', sub: 'Direct message', tint: '#F2B7D6' }
        ];

        const fwdInitials = (name) =>
            name.split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase();

        const fwdTint = (name) => {
            const t = FWD_TARGETS.find(x => x.name === name);
            return (t && t.tint) || '#B7C9F2';
        };

        const fwdChosen = () =>
            [...fwdChips.querySelectorAll('.fwd-chip')].map(c => c.dataset.name);

        const refreshFwdCount = () => {
            const n = fwdChips.querySelectorAll('.fwd-chip').length;
            fwdSubmit.textContent = 'Forward to ' + n + (n === 1 ? ' chat' : ' chats');
            fwdSubmit.disabled = n === 0;
        };

        const addFwdChip = (name) => {
            if (fwdChosen().includes(name)) return;
            const chip = document.createElement('span');
            chip.className = 'fwd-chip';
            chip.dataset.name = name;
            chip.innerHTML = '<span class="fwd-chip__dot"></span>' +
                '<span class="fwd-chip__label"></span>' +
                '<button type="button" class="fwd-chip__x" aria-label="Remove"><i class="bi bi-x-lg"></i></button>';
            const dot = chip.querySelector('.fwd-chip__dot');
            dot.textContent = fwdInitials(name);
            dot.style.background = fwdTint(name);
            chip.querySelector('.fwd-chip__label').textContent = name;
            fwdChips.insertBefore(chip, fwdSearch);
            refreshFwdCount();
        };

        const closeFwdSugg = () => {
            fwdSugg.classList.remove('is-open');
            fwdSugg.innerHTML = '';
        };

        const renderFwdSugg = () => {
            const q = fwdSearch.value.trim().toLowerCase();
            const taken = fwdChosen();
            const hits = FWD_TARGETS
                .filter(t => !taken.includes(t.name))
                .filter(t => !q || t.name.toLowerCase().includes(q));

            if (!hits.length) {
                fwdSugg.innerHTML = '<div class="fwd-sugg__empty">No chats or channels found.</div>';
                fwdSugg.classList.add('is-open');
                return;
            }

            fwdSugg.innerHTML = '<div class="fwd-sugg__label">Chats &amp; channels</div>';
            hits.forEach(t => {
                const row = document.createElement('button');
                row.type = 'button';
                row.className = 'fwd-sugg__row';
                row.innerHTML = '<span class="fwd-chip__dot"></span><span class="fwd-sugg__name"></span>' +
                    '<span class="fwd-sugg__sub"></span>';
                const dot = row.querySelector('.fwd-chip__dot');
                dot.textContent = fwdInitials(t.name);
                dot.style.background = t.tint || '#B7C9F2';
                row.querySelector('.fwd-sugg__name').textContent = t.name;
                row.querySelector('.fwd-sugg__sub').textContent = t.sub;
                row.addEventListener('click', () => {
                    addFwdChip(t.name);
                    fwdSearch.value = '';
                    renderFwdSugg();
                    fwdSearch.focus();
                });
                fwdSugg.appendChild(row);
            });
            fwdSugg.classList.add('is-open');
        };

        if (fwdSearch) {
            fwdSearch.addEventListener('input', renderFwdSugg);
            fwdSearch.addEventListener('focus', renderFwdSugg);
            fwdSearch.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') { closeFwdSugg(); return; }
                if (e.key === 'Backspace' && !fwdSearch.value) {
                    const chips = fwdChips.querySelectorAll('.fwd-chip');
                    if (chips.length) { chips[chips.length - 1].remove(); refreshFwdCount(); renderFwdSugg(); }
                    return;
                }
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const first = fwdSugg.querySelector('.fwd-sugg__row');
                    if (first) first.click();
                }
            });
            // close the dropdown when clicking outside the recipients field
            document.addEventListener('click', (e) => {
                if (!e.target.closest('#fwdChips')) closeFwdSugg();
            });
        }

        // expandable "add a message" field
        const growFwdNote = () => {
            if (!fwdNote) return;
            fwdNote.style.height = 'auto';
            fwdNote.style.height = Math.min(fwdNote.scrollHeight, 120) + 'px';
        };
        fwdNote && fwdNote.addEventListener('input', growFwdNote);

        fwdChips && fwdChips.addEventListener('click', (e) => {
            const x = e.target.closest('.fwd-chip__x');
            if (!x) return;
            x.closest('.fwd-chip').remove();
            refreshFwdCount();
            if (fwdSearch && document.activeElement === fwdSearch) renderFwdSugg();
        });

        const openForward = (row) => {
            // mirror the source message: text, and any attachment it carries
            const text = row && row.querySelector('.bubble__text');
            const author = row && row.querySelector('.msg-author');
            const file = row && row.querySelector('.quote-file__name');
            const attachFile = row && row.querySelector('.attach-file__name');
            const attachMeta = row && row.querySelector('.attach-file__meta');
            const attachImg = row && row.querySelector('.attach-image, .attach-grid');

            if (text) fwdPreviewText.textContent = text.textContent.trim();
            fwdPreviewText.style.display = text ? '' : 'none';

            if (file) fwdPreviewFile.querySelector('.quote-file__name').textContent = file.textContent.trim();
            fwdPreviewFile.style.display = file ? '' : 'none';

            // attachment display (file card and/or image placeholder)
            if (attachFile) {
                fwdAttachName.textContent = attachFile.textContent.trim();
                fwdAttachMeta.textContent = attachMeta ? attachMeta.textContent.trim() : 'Attachment';
            }
            fwdAttachFile.style.display = attachFile ? '' : 'none';
            fwdAttachImage.style.display = attachImg ? '' : 'none';
            fwdPreviewAttach.style.display = (attachFile || attachImg) ? '' : 'none';

            const head = document.querySelector('#forwardModal .fwd-preview__head span');
            if (head) head.textContent = author ? author.textContent.trim() : 'You';

            if (fwdNote) { fwdNote.value = ''; growFwdNote(); }
            closeFwdSugg();
            refreshFwdCount();
            openModal('forwardModal');
        };

        fwdSubmit && fwdSubmit.addEventListener('click', () =>
            closeModal(document.getElementById('forwardModal')));

        // ------------------------------------------------------- rename modal
        const renameInput = document.getElementById('renameInput');
        const renameError = document.getElementById('renameError');
        const renameCounter = document.getElementById('renameCounter');
        const renameSave = document.getElementById('renameSave');

        const validateRename = () => {
            const value = renameInput.value.trim();
            renameCounter.textContent = renameInput.value.length + '/50';
            renameError.classList.toggle('is-shown', !value);
            renameInput.classList.toggle('is-invalid', !value);
            renameSave.disabled = !value;
        };

        renameInput && renameInput.addEventListener('input', validateRename);

        document.getElementById('renameOpen').addEventListener('click', () => {
            const current = document.querySelector('.chat-head__name').textContent.trim();
            renameInput.value = current;
            document.querySelector('#renameModal .zx-modal__sub').textContent =
                'Currently named "' + current + '". Members will see this change in the conversation.';
            validateRename();
            openModal('renameModal');
            renameInput.focus();
            renameInput.select();
        });

        renameSave && renameSave.addEventListener('click', () => {
            const value = renameInput.value.trim();
            if (!value) return;
            document.querySelector('.chat-head__name').textContent = value;
            document.querySelector('.members-panel__title').textContent = value;
            closeModal(document.getElementById('renameModal'));
        });

        // -------------------------------------------------- delete group modal
        const deleteConfirm = document.getElementById('deleteConfirm');
        const deleteSubmit = document.getElementById('deleteSubmit');

        deleteConfirm && deleteConfirm.addEventListener('change', () => {
            deleteSubmit.disabled = !deleteConfirm.checked;
        });

        const openDelete = () => {
            const name = document.querySelector('.chat-head__name').textContent.trim();
            document.querySelector('#deleteModal .zx-modal__title').textContent = 'Delete "' + name + '"?';
            deleteConfirm.checked = false;
            deleteSubmit.disabled = true;
            openModal('deleteModal');
        };

        const deleteGroupOpen = document.getElementById('deleteGroupOpen');
        deleteGroupOpen && deleteGroupOpen.addEventListener('click', openDelete);

        deleteSubmit && deleteSubmit.addEventListener('click', () =>
            closeModal(document.getElementById('deleteModal')));

        // ------------------------------------------------------- image viewer
        const viewer = document.getElementById('imageViewer');
        const imageStage = document.getElementById('imageStage');
        const imageIndex = document.getElementById('imageIndex');
        const shots = [
            'linear-gradient(135deg,#E0E0F7 0%,#CFE0FB 55%,#F0F0FA 100%)',
            'linear-gradient(135deg,#FFD9BF 0%,#FFB199 100%)',
            'linear-gradient(135deg,#B8E0D2 0%,#CFE0FB 100%)',
            'linear-gradient(135deg,#F2B7D6 0%,#E3B7F2 100%)',
            'linear-gradient(135deg,#FFD59E 0%,#FFB199 100%)',
            'linear-gradient(135deg,#C9E4B7 0%,#B8E0D2 100%)',
            'linear-gradient(135deg,#B7C9F2 0%,#EAF3FF 100%)',
            'linear-gradient(135deg,#F2D3B7 0%,#FFD59E 100%)'
        ];
        let shotAt = 0;
        let zoom = 1;

        const paintShot = () => {
            imageStage.style.background = shots[shotAt];
            imageStage.style.transform = 'scale(' + zoom + ')';
            imageIndex.textContent = (shotAt + 1) + ' / ' + shots.length;
        };

        const openViewer = (index) => {
            shotAt = Math.max(0, Math.min(shots.length - 1, index || 0));
            zoom = 1;
            paintShot();
            viewer.classList.add('is-open');
            document.body.style.overflow = 'hidden';
        };

        document.getElementById('imageClose').addEventListener('click', () => {
            viewer.classList.remove('is-open');
            document.body.style.overflow = '';
        });

        document.querySelectorAll('[data-image-step]').forEach(btn => {
            btn.addEventListener('click', () => {
                shotAt = (shotAt + Number(btn.dataset.imageStep) + shots.length) % shots.length;
                zoom = 1;
                paintShot();
            });
        });

        document.querySelectorAll('[data-image-zoom]').forEach(btn => {
            btn.addEventListener('click', () => {
                zoom = btn.dataset.imageZoom === 'in'
                    ? Math.min(2.5, zoom + 0.25)
                    : Math.max(0.5, zoom - 0.25);
                paintShot();
            });
        });

        // any image bubble / photo row opens the viewer
        document.addEventListener('click', (e) => {
            const shot = e.target.closest('[data-open-image], .img-bubble, .img-grid__cell');
            if (!shot || e.target.closest('.img-bubble__dl, .img-grid__all')) return;
            const cells = [...document.querySelectorAll('.img-grid__cell')];
            openViewer(cells.indexOf(shot) > -1 ? cells.indexOf(shot) : 0);
        });

        // ------------------------------------------------------- compose modal
        const composeOpen = document.getElementById('composeOpen');
        composeOpen && composeOpen.addEventListener('click', (e) => {
            e.preventDefault();
            openModal('composeModal');
        });

        const cmpRecipients = document.getElementById('cmpRecipients');

        if (cmpRecipients) {
            const CMP_USERS = [
                { id: 'u1', name: 'Maria Reyes', initials: 'MR', tint: '#FFD59E' },
                { id: 'u2', name: 'Clint Barton', initials: 'CB', tint: '#FFB199' },
                { id: 'u3', name: 'Natasha Romanoff', initials: 'NR', tint: '#B8E0D2' },
                { id: 'u4', name: 'Bruce Banner', initials: 'BB', tint: '#B7C9F2' },
                { id: 'u5', name: 'Steve Rogers', initials: 'SR', tint: '#F2B7D6' }
            ];
            const CMP_GROUPS = [
                { id: 'g1', name: 'HR Team', initials: 'HR', tint: '#B7C9F2', members: '12 members' },
                { id: 'g2', name: 'Design Team', initials: 'DT', tint: '#FFD59E', members: '8 members' },
                { id: 'g3', name: 'Marketing', initials: 'MK', tint: '#A8DAB5', members: '15 members' }
            ];

            const byId = (id) => document.getElementById(id);
            const toInput = byId('cmpToInput');
            const sugg = byId('cmpSugg');
            const modes = byId('cmpModes');
            const browsePop = byId('browsePop');
            const browseList = byId('browseList');
            const browseAllBox = byId('browseAll');
            const sendPop = byId('sendPop');
            const laterPop = byId('laterPop');
            const laterBtn = byId('cmpLater');

            const initialsOf = (name) =>
                name.split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase();

            const chipNames = () =>
                [...cmpRecipients.querySelectorAll('.cmp-chip')].map(c => c.dataset.name);

            // the subject line doubles as the group name when creating a group chat
            const cmpSubject = byId('cmpSubject');
            const syncSubjectLabel = () => {
                if (!cmpSubject) return;
                const active = modes.querySelector('.cmp-mode.is-active');
                const isGroup = modes.classList.contains('is-open')
                    && active && active.dataset.mode === 'group';
                cmpSubject.placeholder = isGroup ? 'Enter Group name' : 'Enter subject';
                cmpSubject.setAttribute('aria-label', isGroup ? 'Group name' : 'Subject');

                // the icon has to follow the field's meaning: a group name, not a subject
                const subjectIcon = byId('cmpSubjectIcon');
                if (subjectIcon) subjectIcon.className = 'bi ' + (isGroup ? 'bi-people' : 'bi-card-heading');
            };

            // two or more recipients reveals Send Separately / Create Group Chat
            const syncModes = () => {
                modes.classList.toggle('is-open', chipNames().length >= 2);
                syncSubjectLabel();
            };

            const addRecipient = (entry) => {
                if (chipNames().includes(entry.name)) return;
                const chip = document.createElement('span');
                chip.className = 'cmp-chip';
                chip.dataset.name = entry.name;
                chip.innerHTML =
                    '<span class="avatar"></span>' +
                    '<span class="cmp-chip__label"></span>' +
                    '<button type="button" class="cmp-chip__x" aria-label="Remove">&times;</button>';
                const av = chip.querySelector('.avatar');
                av.textContent = entry.initials || initialsOf(entry.name);
                av.style.background = entry.tint || '#B7C9F2';
                chip.querySelector('.cmp-chip__label').textContent = entry.name;
                cmpRecipients.insertBefore(chip, toInput);
                syncModes();
            };

            cmpRecipients.addEventListener('click', (e) => {
                const x = e.target.closest('.cmp-chip__x');
                if (!x) return;
                x.closest('.cmp-chip').remove();
                syncModes();
            });

            modes.addEventListener('click', (e) => {
                const btn = e.target.closest('.cmp-mode');
                if (!btn) return;
                modes.querySelectorAll('.cmp-mode').forEach(b => b.classList.remove('is-active'));
                btn.classList.add('is-active');
                syncSubjectLabel();
            });
            syncSubjectLabel();

            // ------------------------------------------------- live suggestions
            const renderSugg = (term) => {
                const q = term.trim().toLowerCase();
                if (!q) return sugg.classList.remove('is-open');

                const taken = chipNames();
                const people = CMP_USERS.filter(u => u.name.toLowerCase().includes(q) && !taken.includes(u.name));
                const groups = CMP_GROUPS.filter(g => g.name.toLowerCase().includes(q) && !taken.includes(g.name));

                if (!people.length && !groups.length) {
                    sugg.innerHTML = '<p class="cmp-sugg__empty">No matches found.</p>';
                    sugg.classList.add('is-open');
                    return;
                }

                const rowHtml = (item) =>
                    '<div class="cmp-sugg__row" data-name="' + item.name + '" data-initials="' + item.initials +
                    '" data-tint="' + item.tint + '">' +
                    '<span class="cmp-sugg__av" style="background:' + item.tint + '">' + item.initials + '</span>' +
                    '<span class="cmp-sugg__name">' + item.name + '</span>' +
                    '<button type="button" class="cmp-sugg__add">+ Add</button></div>';

                let html = '';
                if (people.length) html += '<span class="cmp-sugg__label">People</span>' + people.map(rowHtml).join('');
                if (groups.length) html += '<span class="cmp-sugg__label">Groups</span>' + groups.map(rowHtml).join('');
                sugg.innerHTML = html;
                sugg.classList.add('is-open');
            };

            toInput.addEventListener('input', () => renderSugg(toInput.value));

            toInput.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !toInput.value) {
                    const all = cmpRecipients.querySelectorAll('.cmp-chip');
                    if (all.length) { all[all.length - 1].remove(); syncModes(); }
                }
                if (e.key === 'Escape') sugg.classList.remove('is-open');
            });

            sugg.addEventListener('click', (e) => {
                const row = e.target.closest('.cmp-sugg__row');
                if (!row) return;
                addRecipient({ name: row.dataset.name, initials: row.dataset.initials, tint: row.dataset.tint });
                toInput.value = '';
                sugg.classList.remove('is-open');
                toInput.focus();
            });

            // ------------------------------------------ browse users / groups
            let browseTab = 'users';
            const picked = { users: new Set(), groups: new Set() };
            const sourceFor = (tab) => (tab === 'users' ? CMP_USERS : CMP_GROUPS);

            const renderBrowse = () => {
                const q = (byId('browseSearch').value || '').trim().toLowerCase();
                const rows = sourceFor(browseTab).filter(i => i.name.toLowerCase().includes(q));

                browseList.innerHTML = rows.map(item =>
                    '<label class="cmp-browsepop__row">' +
                    '<input type="checkbox" data-pick="' + item.id + '"' +
                    (picked[browseTab].has(item.id) ? ' checked' : '') + '>' +
                    '<span class="cmp-browsepop__av" style="background:' + item.tint + '">' + item.initials + '</span>' +
                    '<span class="cmp-browsepop__name">' + item.name +
                    (item.members ? '<small>' + item.members + '</small>' : '') +
                    '</span></label>'
                ).join('');

                byId('usersBadge').textContent = picked.users.size;
                byId('groupsBadge').textContent = picked.groups.size;

                const total = picked.users.size + picked.groups.size;
                byId('browseCount').textContent = total + ' selected';
                byId('browseAdd').disabled = total === 0;

                byId('browseAllLabel').textContent = 'Select all ' + browseTab;
                browseAllBox.checked = rows.length > 0 && rows.every(i => picked[browseTab].has(i.id));
            };

            document.querySelectorAll('[data-browse-tab]').forEach(tab => {
                tab.addEventListener('click', () => {
                    document.querySelectorAll('[data-browse-tab]').forEach(t => t.classList.remove('is-active'));
                    tab.classList.add('is-active');
                    browseTab = tab.dataset.browseTab;
                    renderBrowse();
                });
            });

            browseList.addEventListener('change', (e) => {
                const box = e.target.closest('[data-pick]');
                if (!box) return;
                box.checked ? picked[browseTab].add(box.dataset.pick) : picked[browseTab].delete(box.dataset.pick);
                renderBrowse();
            });

            browseAllBox.addEventListener('change', () => {
                const q = (byId('browseSearch').value || '').trim().toLowerCase();
                sourceFor(browseTab).filter(i => i.name.toLowerCase().includes(q)).forEach(i => {
                    browseAllBox.checked ? picked[browseTab].add(i.id) : picked[browseTab].delete(i.id);
                });
                renderBrowse();
            });

            byId('browseSearch').addEventListener('input', renderBrowse);

            byId('browseAdd').addEventListener('click', () => {
                CMP_USERS.filter(u => picked.users.has(u.id)).forEach(addRecipient);
                CMP_GROUPS.filter(g => picked.groups.has(g.id)).forEach(addRecipient);
                picked.users.clear();
                picked.groups.clear();
                closeCmpPops();
                renderBrowse();
            });

            // ------------------------------------------------ popover plumbing
            function closeCmpPops() {
                [browsePop, sendPop, laterPop].forEach(p => p.classList.remove('is-open'));
            }

            const openCmpPop = (pop, anchor, align) => {
                const wasOpen = pop.classList.contains('is-open');
                closeCmpPops();
                if (wasOpen) return;

                pop.classList.add('is-open');
                const a = anchor.getBoundingClientRect();
                const w = pop.offsetWidth;
                const h = pop.offsetHeight;

                let left = align === 'right' ? a.right - w : a.left;
                left = Math.max(8, Math.min(left, window.innerWidth - w - 8));

                let top = a.bottom + 8;
                if (top + h > window.innerHeight - 8) top = Math.max(8, a.top - h - 8);

                pop.style.left = (left + window.scrollX) + 'px';
                pop.style.top = (top + window.scrollY) + 'px';
            };

            byId('cmpBrowse').addEventListener('click', (e) => {
                e.stopPropagation();
                sugg.classList.remove('is-open');
                renderBrowse();
                openCmpPop(browsePop, byId('cmpBrowse'), 'right');
            });

            // ------------------------------------- send as Message / as Email
            const syncSendLabel = () => {
                const msg = byId('sendAsMessage').checked;
                const mail = byId('sendAsEmail').checked;
                byId('cmpSendLabel').textContent =
                    msg && mail ? 'Send as Both' : mail ? 'Send as Email' : 'Send as Message';
                sendPop.querySelectorAll('.cmp-sendpop__row').forEach(row => {
                    row.classList.toggle('is-on', row.querySelector('input').checked);
                });
            };

            byId('cmpSendCaret').addEventListener('click', (e) => {
                e.stopPropagation();
                openCmpPop(sendPop, byId('cmpSendCaret'), 'right');
            });

            sendPop.addEventListener('change', syncSendLabel);
            sendPop.addEventListener('click', (e) => e.stopPropagation());

            // ------------------------------------------------------ send later
            laterBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (!byId('laterDate').value) {
                    byId('laterDate').value = new Date().toISOString().slice(0, 10);
                    byId('laterTime').value = '09:00';
                }
                openCmpPop(laterPop, laterBtn, 'left');
                laterBtn.classList.toggle('is-active', laterPop.classList.contains('is-open'));
            });

            laterPop.addEventListener('click', (e) => e.stopPropagation());

            byId('laterConfirm').addEventListener('click', () => {
                closeCmpPops();
                laterBtn.classList.add('is-active');
            });

            // ----------------------------------------------------- attachments
            const fileInput = byId('cmpFileInput');
            const filesWrap = byId('cmpFiles');
            const fileRow = byId('cmpFileRow');
            let attached = [];

            const prettySize = (bytes) => bytes >= 1048576
                ? (bytes / 1048576).toFixed(1) + ' MB'
                : Math.max(0.1, bytes / 1024).toFixed(1) + ' KB';

            const renderFiles = () => {
                filesWrap.classList.toggle('is-open', attached.length > 0);
                fileRow.innerHTML = attached.map((f, i) =>
                    '<div class="cmp-file">' +
                    '<span class="cmp-file__icon"><i class="bi bi-file-earmark-text"></i></span>' +
                    '<span class="cmp-file__meta">' +
                    '<span class="cmp-file__name" title="' + f.name + '">' + f.name + '</span>' +
                    '<span class="cmp-file__size">' + f.size + '</span></span>' +
                    '<button type="button" class="cmp-file__x" data-drop="' + i + '" aria-label="Remove">' +
                    '<i class="bi bi-x-lg"></i></button></div>'
                ).join('');
                byId('cmpFileMeta').textContent =
                    attached.length + (attached.length === 1 ? ' file' : ' files') +
                    ' attached · Attachments will expire in 14 days';
            };

            byId('cmpAttach').addEventListener('click', () => fileInput.click());

            fileInput.addEventListener('change', () => {
                [...fileInput.files].forEach(f => attached.push({ name: f.name, size: prettySize(f.size) }));
                fileInput.value = '';
                renderFiles();
            });

            fileRow.addEventListener('click', (e) => {
                const drop = e.target.closest('[data-drop]');
                if (!drop) return;
                attached.splice(Number(drop.dataset.drop), 1);
                renderFiles();
            });

            // ---------------------------------------------------- voice to text
            const recBar = byId('cmpRec');
            const voiceBtn = byId('cmpVoice');

            voiceBtn.addEventListener('click', () => {
                const on = recBar.classList.toggle('is-open');
                voiceBtn.classList.toggle('is-rec', on);
            });

            // ------------------------------------------------------- dismissal
            document.addEventListener('click', (e) => {
                if (!e.target.closest('.cmp-pop') && !e.target.closest('#cmpBrowse') &&
                    !e.target.closest('#cmpSendCaret') && !e.target.closest('#cmpLater')) {
                    closeCmpPops();
                }
                if (!e.target.closest('#cmpRecipients')) sugg.classList.remove('is-open');
            });

            document.addEventListener('keydown', (e) => {
                if (e.key !== 'Escape') return;
                closeCmpPops();
                sugg.classList.remove('is-open');
            });

            syncModes();
            renderBrowse();
            syncSendLabel();
        }

        // --------------------------------------------------- use template popover
        // Shared by the compose modal and the chat composer; tplTarget decides where
        // the chosen template text lands.
        const tplPop = document.getElementById('tplPop');
        const tplToggle = document.getElementById('tplToggle');
        const composerTplToggle = document.getElementById('composerTplToggle');
        const cmpMessage = document.getElementById('cmpMessage');

        let tplTarget = cmpMessage;
        let tplAnchor = tplToggle;

        const closeTplPop = () => {
            if (!tplPop) return;
            tplPop.classList.remove('is-open');
            tplToggle && tplToggle.classList.remove('is-active');
            composerTplToggle && composerTplToggle.classList.remove('is-active');
        };

        const openTplPop = (anchor, target) => {
            tplAnchor = anchor;
            tplTarget = target;
            const open = !tplPop.classList.contains('is-open');
            closeTplPop();
            if (!open) return;
            tplPop.classList.add('is-open');
            anchor.classList.add('is-active');
            const rect = anchor.getBoundingClientRect();
            let top = rect.bottom + 8;
            if (top + tplPop.offsetHeight > window.innerHeight - 8) {
                top = Math.max(8, rect.top - tplPop.offsetHeight - 8);
            }
            let left = Math.max(8, rect.left);
            if (left + tplPop.offsetWidth > window.innerWidth - 8) {
                left = Math.max(8, window.innerWidth - tplPop.offsetWidth - 8);
            }
            tplPop.style.top = top + window.scrollY + 'px';
            tplPop.style.left = left + window.scrollX + 'px';
        };

        tplToggle && tplToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            openTplPop(tplToggle, cmpMessage);
        });

        composerTplToggle && composerTplToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            openTplPop(composerTplToggle, composer);
        });

        tplPop && tplPop.addEventListener('click', (e) => {
            const row = e.target.closest('.tpl-row');
            if (!row || !tplTarget) return;
            const quote = row.querySelector('em').textContent.replace(/^"|…"$/g, '');
            tplTarget.value = quote.replace(/^"|"$/g, '');
            tplTarget.focus();
            // let the chat composer's auto-grow pick up the new text
            tplTarget.dispatchEvent(new Event('input', { bubbles: true }));
            closeTplPop();
        });

        document.addEventListener('click', (e) => {
            if (tplPop && !e.target.closest('#tplPop') && !e.target.closest('#tplToggle')
                && !e.target.closest('#composerTplToggle')) {
                closeTplPop();
            }
        });

        // "Forward" in either message menu opens the forward modal
        ['theirMessageMenu', 'myMessageMenu'].forEach(id => {
            const menu = document.getElementById(id);
            menu && menu.addEventListener('click', (e) => {
                const item = e.target.closest('.msg-menu__item');
                if (item && item.textContent.trim().startsWith('Forward')) openForward(menuSourceRow);
            });
        });

        // "Delete chat" in the chat-list kebab asks for confirmation first
        const chatItemMenu = document.getElementById('chatItemMenu');
        chatItemMenu && chatItemMenu.addEventListener('click', (e) => {
            const item = e.target.closest('.msg-menu__item--danger');
            if (!item) return;
            chatItemMenu.classList.remove('is-open');
            openDelete();
        });

        refreshUnreadBadge();
        if (stream) stream.scrollTop = stream.scrollHeight;
    })();
</script>
}
